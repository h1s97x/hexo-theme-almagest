// ============================================================
// Layout Styles
// ============================================================

// ============================================================
// App Container
// ============================================================

// 背景必须透明：底色与星云/星空分别由 html / html::before / .starry-background 三层负责。
// 若此处设成 var(--color-bg) 不透明底，会把 canvas 星空整片盖住。
.app-container
  display flex
  flex-direction column
  min-height 100vh
  background-color transparent
  color var(--color-text)
  transition background-color $transition-base, color $transition-base

// ============================================================
// Header
// ============================================================
// 此处定义跨尺寸的布局骨架（flex 排列、按钮外观、图标互斥等）。
// 各断点下的尺寸微调见 _responsive.styl（mobile-first，顶层为移动端）。
// 注意：_responsive.styl 中的对应选择器必须与此保持相同特异性，
// 否则断点增强样式无法覆盖（媒体查询不改变特异性）。
// ============================================================

.site-header
  background-color var(--color-glass-bg)
  backdrop-filter blur(var(--color-glass-blur))
  -webkit-backdrop-filter blur(var(--color-glass-blur))
  border-bottom 1px solid var(--color-border)
  position sticky
  top 0
  z-index $z-index-sticky
  transition background-color $transition-base, border-color $transition-base

.header-container
  display flex
  align-items center
  justify-content space-between
  width 100%
  max-width $container-width-2xl
  margin 0 auto
  gap $space-md

.logo
  flex-shrink 0

.logo-link
  display inline-flex
  align-items center
  text-decoration none
  color var(--color-text)
  transition color $transition-base

  &:hover
    color var(--color-link)

// 站点名走星野渐变，导航 hover 时点亮
.logo-text
  font-size $font-size-xl
  font-weight $font-weight-bold
  background-image var(--grad-text)
  -webkit-background-clip text
  background-clip text
  -webkit-text-fill-color transparent
  color var(--color-text)
  white-space nowrap
  transition color $transition-base

.site-nav
  display flex
  align-items center
  gap $space-lg

.nav-link
  position relative
  font-size $font-size-base
  color var(--color-text-secondary)
  text-decoration none
  padding $space-xs 0
  white-space nowrap
  transition color $transition-base

  // hover 时下方浮出一小段渐变下划线
  &::after
    content ''
    position absolute
    left 0
    right 0
    bottom -2px
    height 2px
    border-radius $border-radius-full
    background-image var(--grad-primary)
    transform scaleX(0)
    transform-origin left
    transition transform $transition-base

  &:hover
    color var(--color-link)

    &::after
      transform scaleX(1)

.header-actions
  display flex
  align-items center
  gap $space-sm
  flex-shrink 0

.action-btn
  display inline-flex
  align-items center
  justify-content center
  width 40px
  height 40px
  padding 0
  border none
  border-radius $border-radius-md
  background-color transparent
  color var(--color-text-secondary)
  cursor pointer
  text-decoration none
  transition background-color $transition-base, color $transition-base

  svg
    width 20px
    height 20px

  &:hover
    background-color var(--color-hover-bg)
    color var(--color-text)

  &:focus-visible
    outline 2px solid var(--color-link)
    outline-offset 2px

// 明暗图标互斥：亮色显示太阳（点击切暗色），暗色显示月亮（点击切亮色）
.theme-toggle-btn
  .moon-icon
    display none

[data-theme='dark'] .theme-toggle-btn
  .sun-icon
    display none

  .moon-icon
    display block

.mobile-menu
  // 玻璃态：与 site-header 一致，避免展开时形成一块死黑板
  background-color var(--color-glass-bg)
  backdrop-filter blur(var(--color-glass-blur))
  -webkit-backdrop-filter blur(var(--color-glass-blur))
  border-bottom 1px solid var(--color-border)

.mobile-nav
  display flex
  flex-direction column
  width 100%
  max-width $container-width-2xl
  margin 0 auto

.mobile-nav-link
  color var(--color-text-secondary)
  text-decoration none
  transition color $transition-base, background-color $transition-base

  &:hover
    color var(--color-link)
    background-color var(--color-hover-bg)

// ============================================================
// Main Content
// ============================================================

.main-content
  flex 1
  padding $space-2xl 0
  // 透明：让底下的 canvas 星空与星云透上来
  background-color transparent
  transition background-color $transition-base

// ============================================================
// Container
// ============================================================

.container
  width 100%
  max-width $container-width-2xl
  margin 0 auto
  padding 0 $space-lg

// ============================================================
// Content Wrapper
// ============================================================
// Breakpoint Strategy:
// - Mobile (< 768px): Single column, no sidebar
// - Tablet (768px - 1024px): Two column with sidebar (280px)
// - Desktop (> 1024px): Two column with sidebar (300px)
// ============================================================

.content-wrapper
  display grid
  grid-template-columns 1fr
  gap $space-2xl

  // Mobile layout - single column
  @media (max-width: ($breakpoint-md - 1px))
    grid-template-columns 1fr

  // Tablet and desktop layout - two columns (sidebar)
  &.with-sidebar
    @media (min-width: $breakpoint-md)
      grid-template-columns 1fr 280px

      @media (min-width: $breakpoint-lg)
        grid-template-columns 1fr 300px

  // No sidebar: always single column
  &.no-sidebar
    grid-template-columns 1fr

// ============================================================
// Article Container
// ============================================================

.article-container
  min-width 0
  // 透明：避免盖住星空（正文可读性由卡片与文字色保证）
  background-color transparent

// ============================================================
// Sidebar
// ============================================================
// Visibility Strategy:
// - Mobile (< 768px): Hidden
// - Tablet (768px - 1024px): Visible
// - Desktop (> 1024px): Visible
// ============================================================

// 侧边栏本身是透明的布局容器，只负责纵向排列与间距；
// 卡片观感（背景/圆角/内边距）下放到每个 .widget 自身，
// 参考 hexo-theme-stellar 的 .widget-wrapper/.widget-body 分层方式。
//
// display 不在此处设置：_responsive.styl 在 main.styl 中后导入，
// 其顶层的 display:none 会覆盖此处的值，断点显示由它统一控制
// （移动端 none / >=768px flex）。重复声明只会造成误导。
.sidebar
  flex-direction column
  gap $space-lg

// ============================================================
// Page Header
// ============================================================

.page-header
  margin-bottom $space-3xl
  text-align center
  padding $space-2xl 0

  .page-title
    margin 0 0 $space-sm 0
    font-size $font-size-4xl
    font-weight $font-weight-bold
    color var(--color-text)
    transition color $transition-base

  .page-subtitle
    margin 0
    font-size $font-size-lg
    color var(--color-text-secondary)
    transition color $transition-base

// ============================================================
// Posts Container
// ============================================================

.posts-container
  display flex
  flex-direction column
  gap $space-2xl

// ============================================================
// Post Card（玻璃态卡片 + 星辉 hover）
// ============================================================

.post-card
  position relative
  background-color var(--color-bg-secondary)
  border 1px solid var(--color-border)
  border-radius $border-radius-lg
  padding $space-lg
  box-shadow var(--shadow-card)
  transition background-color $transition-base, border-color $transition-base, box-shadow $transition-base, transform $transition-base
  overflow hidden

  // 顶部一道极细的星蓝渐光线，hover 时点亮
  &::before
    content ''
    position absolute
    top 0
    left 0
    right 0
    height 1px
    background-image var(--grad-primary)
    opacity 0
    transition opacity $transition-slow

  &:hover
    background-color var(--color-hover-bg)
    border-color var(--color-tag-border)
    box-shadow var(--shadow-card-hover), var(--glow-soft)
    transform translateY(-3px)

    &::before
      opacity 1

    .post-title a
      background-image var(--grad-text)
      -webkit-background-clip text
      background-clip text
      -webkit-text-fill-color transparent

// ============================================================
// Post Card 标题 / 元信息
// ============================================================

.post-title
  margin 0 0 $space-sm 0
  font-size $font-size-2xl
  line-height $line-height-tight

  a
    color var(--color-text)
    text-decoration none
    transition color $transition-base

    &:hover
      color var(--color-link)

.post-meta
  display flex
  flex-wrap wrap
  align-items center
  gap $space-md
  margin-bottom $space-md
  font-size $font-size-sm
  color var(--color-text-tertiary)

  a
    color var(--color-link)

.post-excerpt
  margin 0 0 $space-md 0
  color var(--color-text-secondary)
  line-height $line-height-relaxed

.post-read-more
  display inline-block
  font-size $font-size-sm
  font-weight $font-weight-medium
  color var(--color-link)
  text-decoration none
  transition color $transition-base, transform $transition-base

  &:hover
    color var(--color-link-hover)
    transform translateX(3px)

// ============================================================
// No Posts Message
// ============================================================

.no-posts
  text-align center
  padding $space-3xl $space-md
  background-color var(--color-bg-secondary)
  border-radius $border-radius-lg
  border 1px solid var(--color-border)
  transition background-color $transition-base, border-color $transition-base

  p
    margin 0
    color var(--color-text-secondary)
    font-size $font-size-lg
    transition color $transition-base

// ============================================================
// Footer
// ============================================================

// 与 Header 同理：此处定义跨尺寸布局骨架，断点微调见 _responsive.styl。
// _responsive.styl 中对应选择器已同步为 .site-footer（同为单类选择器），
// 否则此处较高的特异性会让断点 padding 失效。

.site-footer
  // 玻璃态收尾，与 header 呼应
  background-color var(--color-glass-bg)
  backdrop-filter blur(var(--color-glass-blur))
  -webkit-backdrop-filter blur(var(--color-glass-blur))
  border-top 1px solid var(--color-border)
  padding $space-2xl 0
  margin-top $space-3xl
  transition background-color $transition-base, border-color $transition-base

.footer-container
  width 100%
  max-width $container-width-2xl
  margin 0 auto
  padding 0 $space-lg

.footer-content
  display grid
  grid-template-columns 1fr
  gap $space-xl
  padding-bottom $space-xl

.footer-section
  min-width 0

.footer-title
  font-size $font-size-lg
  font-weight $font-weight-semibold
  color var(--color-text)
  margin-bottom $space-sm

.footer-description
  font-size $font-size-sm
  color var(--color-text-secondary)
  line-height $line-height-relaxed
  margin-bottom 0

.social-links
  display flex
  align-items center
  gap $space-sm
  flex-wrap wrap

.social-link
  display inline-flex
  align-items center
  justify-content center
  width 40px
  height 40px
  border-radius $border-radius-md
  color var(--color-text-secondary)
  text-decoration none
  transition background-color $transition-base, color $transition-base

  svg
    width 20px
    height 20px

  &:hover
    background-color var(--color-hover-bg)
    color var(--color-text)

  &:focus-visible
    outline 2px solid var(--color-link)
    outline-offset 2px

.footer-bottom
  display flex
  flex-direction column
  align-items center
  gap $space-xs
  padding-top $space-lg
  border-top 1px solid var(--color-border)
  text-align center

.copyright
  font-size $font-size-sm
  color var(--color-text-secondary)
  margin-bottom 0

.powered-by
  font-size $font-size-sm
  color var(--color-text-tertiary)
  margin-bottom 0

  a
    color var(--color-link)
    text-decoration none

    &:hover
      text-decoration underline

// ============================================================
// Back to Top Button
// ============================================================

.back-to-top
  position fixed
  bottom $space-lg
  right $space-lg
  width 48px
  height 48px
  min-width 48px
  min-height 48px
  border-radius 50%
  background-image var(--grad-primary)
  background-color $primary-color
  color #05070f
  border none
  cursor pointer
  display none
  align-items center
  justify-content center
  box-shadow $shadow-deep-md, $glow-primary-soft
  transition background-color $transition-base, box-shadow $transition-base, transform $transition-base

  z-index $z-index-fixed

  &.show
    display flex

  &:hover
    box-shadow $shadow-deep-lg, $glow-primary
    transform translateY(-3px)

  &:active
    transform translateY(0)

  svg
    width 24px
    height 24px

// ============================================================
// Grid Layout
// ============================================================

.grid
  display grid
  gap $space-lg

  &.grid-2
    grid-template-columns repeat(2, 1fr)

    @media (max-width: $breakpoint-md)
      grid-template-columns 1fr

  &.grid-3
    grid-template-columns repeat(3, 1fr)

    @media (max-width: $breakpoint-lg)
      grid-template-columns repeat(2, 1fr)

    @media (max-width: $breakpoint-md)
      grid-template-columns 1fr

  &.grid-4
    grid-template-columns repeat(4, 1fr)

    @media (max-width: $breakpoint-xl)
      grid-template-columns repeat(3, 1fr)

    @media (max-width: $breakpoint-lg)
      grid-template-columns repeat(2, 1fr)

    @media (max-width: $breakpoint-md)
      grid-template-columns 1fr

// ============================================================
// Flex Layout
// ============================================================

.flex
  display flex

  &.flex-center
    align-items center
    justify-content center

  &.flex-between
    align-items center
    justify-content space-between

  &.flex-column
    flex-direction column

  &.flex-wrap
    flex-wrap wrap

  &.gap-sm
    gap $space-sm

  &.gap-md
    gap $space-md

  &.gap-lg
    gap $space-lg

// ============================================================
// Spacing Utilities
// ============================================================

.p-xs
  padding $space-xs

.p-sm
  padding $space-sm

.p-md
  padding $space-md

.p-lg
  padding $space-lg

.p-xl
  padding $space-xl

.m-xs
  margin $space-xs

.m-sm
  margin $space-sm

.m-md
  margin $space-md

.m-lg
  margin $space-lg

.m-xl
  margin $space-xl

// ============================================================
// Display Utilities
// ============================================================

.hidden
  display none

.visible
  display block

.inline
  display inline

.inline-block
  display inline-block

.block
  display block


