// ============================================================
// Layout Styles
// ============================================================

// ============================================================
// App Container
// ============================================================

.app-container
  display flex
  flex-direction column
  min-height 100vh
  background-color var(--color-bg)
  color var(--color-text)
  transition background-color $transition-base, color $transition-base

// ============================================================
// Header
// ============================================================
// 此处定义跨尺寸的布局骨架（flex 排列、按钮外观、图标互斥等）。
// 各断点下的尺寸微调见 _responsive.styl（mobile-first，顶层为移动端）。
// 注意：_responsive.styl 中的对应选择器必须与此保持相同特异性，
// 否则断点增强样式无法覆盖（媒体查询不改变特异性）。
// ============================================================

.site-header
  background-color var(--color-bg)
  border-bottom 1px solid var(--color-border)
  position sticky
  top 0
  z-index $z-index-sticky
  transition background-color $transition-base, border-color $transition-base

.header-container
  display flex
  align-items center
  justify-content space-between
  width 100%
  max-width $container-width-2xl
  margin 0 auto
  gap $space-md

.logo
  flex-shrink 0

.logo-link
  display inline-flex
  align-items center
  text-decoration none
  color var(--color-text)
  transition color $transition-base

  &:hover
    color var(--color-link)

.logo-text
  font-size $font-size-xl
  font-weight $font-weight-bold
  color var(--color-text)
  white-space nowrap
  transition color $transition-base

.site-nav
  display flex
  align-items center
  gap $space-lg

.nav-link
  position relative
  font-size $font-size-base
  color var(--color-text-secondary)
  text-decoration none
  padding $space-xs 0
  white-space nowrap
  transition color $transition-base

  &:hover
    color var(--color-link)

.header-actions
  display flex
  align-items center
  gap $space-sm
  flex-shrink 0

.action-btn
  display inline-flex
  align-items center
  justify-content center
  width 40px
  height 40px
  padding 0
  border none
  border-radius $border-radius-md
  background-color transparent
  color var(--color-text-secondary)
  cursor pointer
  text-decoration none
  transition background-color $transition-base, color $transition-base

  svg
    width 20px
    height 20px

  &:hover
    background-color var(--color-hover-bg)
    color var(--color-text)

  &:focus-visible
    outline 2px solid var(--color-link)
    outline-offset 2px

// 明暗图标互斥：亮色显示太阳（点击切暗色），暗色显示月亮（点击切亮色）
.theme-toggle-btn
  .moon-icon
    display none

[data-theme='dark'] .theme-toggle-btn
  .sun-icon
    display none

  .moon-icon
    display block

.mobile-menu
  background-color var(--color-bg)
  border-bottom 1px solid var(--color-border)

.mobile-nav
  display flex
  flex-direction column
  width 100%
  max-width $container-width-2xl
  margin 0 auto

.mobile-nav-link
  color var(--color-text-secondary)
  text-decoration none
  transition color $transition-base, background-color $transition-base

  &:hover
    color var(--color-link)
    background-color var(--color-hover-bg)

// ============================================================
// Main Content
// ============================================================

.main-content
  flex 1
  padding $space-2xl 0
  background-color var(--color-bg)
  transition background-color $transition-base

// ============================================================
// Container
// ============================================================

.container
  width 100%
  max-width $container-width-2xl
  margin 0 auto
  padding 0 $space-lg

// ============================================================
// Content Wrapper
// ============================================================
// Breakpoint Strategy:
// - Mobile (< 768px): Single column, no sidebar
// - Tablet (768px - 1024px): Two column with sidebar (280px)
// - Desktop (> 1024px): Two column with sidebar (300px)
// ============================================================

.content-wrapper
  display grid
  grid-template-columns 1fr
  gap $space-2xl

  // Mobile layout - single column
  @media (max-width: ($breakpoint-md - 1px))
    grid-template-columns 1fr

  // Tablet and desktop layout - two columns (sidebar)
  &.with-sidebar
    @media (min-width: $breakpoint-md)
      grid-template-columns 1fr 280px

      @media (min-width: $breakpoint-lg)
        grid-template-columns 1fr 300px

  // No sidebar: always single column
  &.no-sidebar
    grid-template-columns 1fr

// ============================================================
// Article Container
// ============================================================

.article-container
  min-width 0
  background-color var(--color-bg)

// ============================================================
// Sidebar
// ============================================================
// Visibility Strategy:
// - Mobile (< 768px): Hidden
// - Tablet (768px - 1024px): Visible
// - Desktop (> 1024px): Visible
// ============================================================

// 侧边栏本身是透明的布局容器，只负责纵向排列与间距；
// 卡片观感（背景/圆角/内边距）下放到每个 .widget 自身，
// 参考 hexo-theme-stellar 的 .widget-wrapper/.widget-body 分层方式。
//
// display 不在此处设置：_responsive.styl 在 main.styl 中后导入，
// 其顶层的 display:none 会覆盖此处的值，断点显示由它统一控制
// （移动端 none / >=768px flex）。重复声明只会造成误导。
.sidebar
  flex-direction column
  gap $space-lg

// ============================================================
// Page Header
// ============================================================

.page-header
  margin-bottom $space-3xl
  text-align center
  padding $space-2xl 0

  .page-title
    margin 0 0 $space-sm 0
    font-size $font-size-4xl
    font-weight $font-weight-bold
    color var(--color-text)
    transition color $transition-base

  .page-subtitle
    margin 0
    font-size $font-size-lg
    color var(--color-text-secondary)
    transition color $transition-base

// ============================================================
// Posts Container
// ============================================================

.posts-container
  display flex
  flex-direction column
  gap $space-2xl

// ============================================================
// Post Card
// ============================================================

.post-card
  background-color var(--color-bg-secondary)
  border 1px solid var(--color-border)
  border-radius $border-radius-lg
  padding $space-lg
  transition background-color $transition-base, border-color $transition-base, box-shadow $transition-base

  &:hover
    background-color var(--color-hover-bg)
    box-shadow $shadow-md

// ============================================================
// No Posts Message
// ============================================================

.no-posts
  text-align center
  padding $space-3xl $space-md
  background-color var(--color-bg-secondary)
  border-radius $border-radius-lg
  border 1px solid var(--color-border)
  transition background-color $transition-base, border-color $transition-base

  p
    margin 0
    color var(--color-text-secondary)
    font-size $font-size-lg
    transition color $transition-base

// ============================================================
// Footer
// ============================================================

// 与 Header 同理：此处定义跨尺寸布局骨架，断点微调见 _responsive.styl。
// _responsive.styl 中对应选择器已同步为 .site-footer（同为单类选择器），
// 否则此处较高的特异性会让断点 padding 失效。

.site-footer
  background-color var(--color-bg-secondary)
  border-top 1px solid var(--color-border)
  padding $space-2xl 0
  margin-top $space-3xl
  transition background-color $transition-base, border-color $transition-base

.footer-container
  width 100%
  max-width $container-width-2xl
  margin 0 auto
  padding 0 $space-lg

.footer-content
  display grid
  grid-template-columns 1fr
  gap $space-xl
  padding-bottom $space-xl

.footer-section
  min-width 0

.footer-title
  font-size $font-size-lg
  font-weight $font-weight-semibold
  color var(--color-text)
  margin-bottom $space-sm

.footer-description
  font-size $font-size-sm
  color var(--color-text-secondary)
  line-height $line-height-relaxed
  margin-bottom 0

.social-links
  display flex
  align-items center
  gap $space-sm
  flex-wrap wrap

.social-link
  display inline-flex
  align-items center
  justify-content center
  width 40px
  height 40px
  border-radius $border-radius-md
  color var(--color-text-secondary)
  text-decoration none
  transition background-color $transition-base, color $transition-base

  svg
    width 20px
    height 20px

  &:hover
    background-color var(--color-hover-bg)
    color var(--color-text)

  &:focus-visible
    outline 2px solid var(--color-link)
    outline-offset 2px

.footer-bottom
  display flex
  flex-direction column
  align-items center
  gap $space-xs
  padding-top $space-lg
  border-top 1px solid var(--color-border)
  text-align center

.copyright
  font-size $font-size-sm
  color var(--color-text-secondary)
  margin-bottom 0

.powered-by
  font-size $font-size-sm
  color var(--color-text-tertiary)
  margin-bottom 0

  a
    color var(--color-link)
    text-decoration none

    &:hover
      text-decoration underline

// ============================================================
// Back to Top Button
// ============================================================

.back-to-top
  position fixed
  bottom $space-lg
  right $space-lg
  width 48px
  height 48px
  border-radius 50%
  background-color $primary-color
  color white
  border none
  cursor pointer
  display none
  align-items center
  justify-content center
  box-shadow $shadow-lg
  smooth-transition()

  z-index $z-index-fixed

  &.show
    display flex

  &:hover
    background-color $primary-dark
    box-shadow $shadow-xl
    transform translateY(-2px)

  &:active
    transform translateY(0)

  svg
    width 24px
    height 24px

// ============================================================
// Grid Layout
// ============================================================

.grid
  display grid
  gap $space-lg

  &.grid-2
    grid-template-columns repeat(2, 1fr)

    @media (max-width: $breakpoint-md)
      grid-template-columns 1fr

  &.grid-3
    grid-template-columns repeat(3, 1fr)

    @media (max-width: $breakpoint-lg)
      grid-template-columns repeat(2, 1fr)

    @media (max-width: $breakpoint-md)
      grid-template-columns 1fr

  &.grid-4
    grid-template-columns repeat(4, 1fr)

    @media (max-width: $breakpoint-xl)
      grid-template-columns repeat(3, 1fr)

    @media (max-width: $breakpoint-lg)
      grid-template-columns repeat(2, 1fr)

    @media (max-width: $breakpoint-md)
      grid-template-columns 1fr

// ============================================================
// Flex Layout
// ============================================================

.flex
  display flex

  &.flex-center
    align-items center
    justify-content center

  &.flex-between
    align-items center
    justify-content space-between

  &.flex-column
    flex-direction column

  &.flex-wrap
    flex-wrap wrap

  &.gap-sm
    gap $space-sm

  &.gap-md
    gap $space-md

  &.gap-lg
    gap $space-lg

// ============================================================
// Spacing Utilities
// ============================================================

.p-xs
  padding $space-xs

.p-sm
  padding $space-sm

.p-md
  padding $space-md

.p-lg
  padding $space-lg

.p-xl
  padding $space-xl

.m-xs
  margin $space-xs

.m-sm
  margin $space-sm

.m-md
  margin $space-md

.m-lg
  margin $space-lg

.m-xl
  margin $space-xl

// ============================================================
// Display Utilities
// ============================================================

.hidden
  display none

.visible
  display block

.inline
  display inline

.inline-block
  display inline-block

.block
  display block


