// ============================================================
// Observation Guide Component —— 补充样式
// ============================================================
// 说明：`.observation-guide` / `.guide-header` / `.guide-section` /
// `.guide-content` / `.guide-tips` 的基础样式已在 `_astronomy.styl` 中
// 定义并走主题变量。本文件仅保留「此处独有」的额外选择器，
// 避免同名规则重复定义造成两处样式漂移（原实现为整块复制，已去重）。
// 加载顺序在 `_astronomy.styl` 之后，故此处可对基础样式做补充。

// 位置行：图标 + 地名（flex 对齐）
.guide-location
  display: flex
  align-items: center
  gap: $space-sm
  font-size: $font-size-sm
  color: var(--color-text-tertiary)

// 观测时段（如 "20:00 - 23:00 最佳"）
.constellation-time
  font-size: $font-size-sm
  color: var(--color-text-tertiary)

// 正文内链接
.guide-content
  a
    color: var(--color-link)
    text-decoration: none

    &:hover
      color: var(--color-link-hover)
      text-decoration: underline

@media (max-width: $breakpoint-md)
  .observation-guide
    padding: $space-md

  .guide-section
    margin-bottom: $space-md
