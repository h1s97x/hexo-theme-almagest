// Astronomy Theme Styles
// Starry background and astronomy-themed components
//
// 说明：本文件所有组件均走 var(--color-*) 主题变量，明暗双主题通用。
// 早期版本硬编码 rgba(255,255,255,...) 浅色值，导致亮色主题下白字白底不可读，
// 现已全部替换为语义变量（玻璃态底 / 边框 / 文字三级色 / 强调色）。

// ============================================================
// Starry background（星野底）
// ============================================================

// 层级规划（自下而上）：
//   html 底色  <  html::before 星云(z:0)  <  .starry-background 星空(z:1)  <  .app-container 内容(z:2)
// 关键点：
//   1) 本层必须 z-index >= 0 —— 用 -1 会被 html/body 底色盖住，星空永远看不见；
//   2) 本层背景必须是 transparent —— 否则会整片遮住 html::before 的星云光晕；
//   3) .app-container 也必须透明且层级更高，内容才不会挡星。
.starry-background
  position: fixed
  top: 0
  left: 0
  width: 100%
  height: 100%
  z-index: 1
  pointer-events: none
  background: transparent

  // 星云光晕层：几团径向渐变模拟银河柔光
  &::before
    content: ''
    position: absolute
    width: 100%
    height: 100%
    background-image: radial-gradient(60% 60% at 15% 8%, rgba(103, 232, 249, 0.1) 0%, transparent 70%), radial-gradient(50% 50% at 85% 18%, rgba(167, 139, 250, 0.1) 0%, transparent 70%), radial-gradient(70% 50% at 50% 100%, rgba(129, 140, 248, 0.07) 0%, transparent 75%)
    background-repeat: no-repeat
    animation: twinkle 8s ease-in-out infinite

  // 星空画布（由 source/js/astronomy.js 绘制，单节点代替上百个 DOM 星点）
  .starfield-canvas
    position: absolute
    top: 0
    left: 0
    display: block
    width: 100%
    height: 100%

    &.twinkle
      animation: twinkle 6s ease-in-out infinite

@keyframes twinkle
  0%, 100%
    opacity: 0.55

  50%
    opacity: 1

// 尊重系统「减少动态效果」偏好
@media (prefers-reduced-motion: reduce)
  .starry-background
    &::before
      animation: none

    .starfield-canvas.twinkle
      animation: none

// ============================================================
// Astronomy card（玻璃态卡片）
// ============================================================

.astronomy-card
  background: var(--color-glass-bg)
  border: 1px solid var(--color-glass-border)
  border-radius: $border-radius-lg
  padding: $space-lg
  backdrop-filter: blur(var(--color-glass-blur))
  -webkit-backdrop-filter: blur(var(--color-glass-blur))
  box-shadow: var(--shadow-card)
  transition: background-color $transition-base, border-color $transition-base, box-shadow $transition-base, transform $transition-base

  &:hover
    background: var(--color-hover-bg)
    border-color: var(--color-tag-border)
    box-shadow: var(--shadow-card-hover), var(--glow-soft)
    transform: translateY(-3px)

  .astronomy-card-header
    display: flex
    align-items: center
    margin-bottom: $space-md

    .astronomy-card-icon
      font-size: 2rem
      margin-right: $space-md

    .astronomy-card-title
      font-size: $font-size-xl
      font-weight: $font-weight-semibold
      margin: 0
      color: var(--color-text)

  .astronomy-card-body
    color: var(--color-text-secondary)
    line-height: $line-height-relaxed

    p
      margin: $space-sm 0

  .astronomy-card-footer
    margin-top: $space-md
    padding-top: $space-md
    border-top: 1px solid var(--color-border)
    font-size: $font-size-sm
    color: var(--color-text-tertiary)

// ============================================================
// Constellation navigation（星图导航）
// ============================================================

.constellation-nav
  display: grid
  grid-template-columns: repeat(auto-fit, minmax(100px, 1fr))
  gap: $space-md
  margin: $space-xl 0

  .constellation-item
    position: relative
    aspect-ratio: 1
    border-radius: $border-radius-lg
    overflow: hidden
    cursor: pointer
    transition: background-color $transition-base, border-color $transition-base, transform $transition-base, box-shadow $transition-base
    background: var(--color-bg-secondary)
    border: 1px solid var(--color-border)
    display: flex
    align-items: center
    justify-content: center
    flex-direction: column
    text-decoration: none

    &:hover
      background: var(--color-hover-bg)
      border-color: var(--color-tag-border)
      transform: scale(1.05)
      box-shadow: var(--glow-soft)

    &.active
      background: var(--color-tag-bg)
      border-color: var(--color-accent)
      box-shadow: var(--glow-primary)

    .constellation-icon
      font-size: 2rem
      margin-bottom: $space-sm

    .constellation-name
      font-size: $font-size-sm
      font-weight: $font-weight-medium
      text-align: center
      color: var(--color-text-secondary)

// ============================================================
// Astronomy event calendar（天文日历）
// ============================================================

.astronomy-calendar
  background: var(--color-glass-bg)
  border: 1px solid var(--color-glass-border)
  border-radius: $border-radius-lg
  padding: $space-lg
  backdrop-filter: blur(var(--color-glass-blur))
  -webkit-backdrop-filter: blur(var(--color-glass-blur))
  box-shadow: var(--shadow-card)

  .calendar-header
    display: flex
    justify-content: space-between
    align-items: center
    margin-bottom: $space-lg

    h3
      margin: 0
      color: var(--color-text)

    .calendar-nav
      display: flex
      gap: $space-sm

      button
        background: var(--color-bg-secondary)
        border: 1px solid var(--color-border)
        color: var(--color-text)
        padding: $space-sm $space-md
        border-radius: $border-radius-md
        cursor: pointer
        transition: background-color $transition-fast, border-color $transition-fast, color $transition-fast

        &:hover
          background: var(--color-hover-bg)
          border-color: var(--color-accent)
          color: var(--color-accent)

  .calendar-grid
    display: grid
    grid-template-columns: repeat(7, 1fr)
    gap: $space-sm

    .calendar-day-header
      text-align: center
      font-weight: $font-weight-semibold
      color: var(--color-text-tertiary)
      padding: $space-sm
      font-size: $font-size-sm

    .calendar-day
      aspect-ratio: 1
      display: flex
      align-items: center
      justify-content: center
      background: var(--color-bg-secondary)
      border: 1px solid var(--color-border)
      border-radius: $border-radius-md
      cursor: pointer
      transition: background-color $transition-fast, border-color $transition-fast
      color: var(--color-text-secondary)
      font-size: $font-size-sm

      &.empty
        background: transparent
        border-color: transparent
        cursor: default

      &:hover
        background: var(--color-hover-bg)
        border-color: var(--color-accent)

      &.has-event
        background: var(--color-tag-bg)
        border-color: var(--color-tag-border)
        color: var(--color-tag-text)
        font-weight: $font-weight-semibold

      &.today
        background: rgba(251, 191, 36, 0.12)
        border-color: rgba(251, 191, 36, 0.45)
        color: var(--color-text)
        font-weight: $font-weight-semibold

  .calendar-events
    margin-top: $space-lg
    padding-top: $space-lg
    border-top: 1px solid var(--color-border)

    .event-item
      padding: $space-md
      margin-bottom: $space-sm
      background: rgba(103, 232, 249, 0.08)
      border-left: 3px solid var(--color-accent)
      border-radius: $border-radius-sm

      .event-name
        font-weight: $font-weight-semibold
        color: var(--color-text)
        margin-bottom: $space-xs

      .event-time
        font-size: $font-size-sm
        color: var(--color-text-tertiary)

// ============================================================
// Observation guide（观测指南）
// ============================================================

.observation-guide
  background: var(--color-glass-bg)
  border: 1px solid var(--color-glass-border)
  border-radius: $border-radius-lg
  padding: $space-lg
  backdrop-filter: blur(var(--color-glass-blur))
  -webkit-backdrop-filter: blur(var(--color-glass-blur))
  box-shadow: var(--shadow-card)

  .guide-header
    margin-bottom: $space-lg

    h3
      margin: 0 0 $space-sm 0
      color: var(--color-text)

    .guide-location
      font-size: $font-size-sm
      color: var(--color-text-tertiary)

  .guide-section
    margin-bottom: $space-lg

    h4
      color: var(--color-text)
      margin: 0 0 $space-sm 0
      font-size: $font-size-base

    .guide-content
      color: var(--color-text-secondary)
      line-height: $line-height-relaxed

      ul, ol
        margin: $space-sm 0
        padding-left: $space-lg

        li
          margin-bottom: $space-sm

  .guide-tips
    background: var(--color-alert-warning-bg)
    border-left: 3px solid var(--color-warning)
    padding: $space-md
    border-radius: $border-radius-sm
    margin-top: $space-md

    .tips-title
      font-weight: $font-weight-semibold
      color: var(--color-alert-warning-text)
      margin-bottom: $space-sm

    .tips-content
      color: var(--color-text-secondary)
      font-size: $font-size-sm

// ============================================================
// 兼容：旧版 body.astronomy-theme 强制深色（保留但走变量）
// ============================================================

body.astronomy-theme
  background: var(--color-bg)
  color: var(--color-text)

  .main-content
    background: transparent

  a
    color: var(--color-link)

    &:hover
      color: var(--color-link-hover)

// ============================================================
// Responsive adjustments
// ============================================================

@media (max-width: $breakpoint-md)
  .constellation-nav
    grid-template-columns: repeat(auto-fit, minmax(80px, 1fr))

  .astronomy-card
    padding: $space-md

  .calendar-grid
    gap: $space-xs

    .calendar-day
      font-size: $font-size-xs
