// Hexo Theme Almagest - Extra Components Styles
// ==============================================

// ============================================
// Mermaid - 图表样式
// ============================================

.mermaid
  text-align: center
  padding: $spacing-lg
  background: var(--color-bg)
  border-radius: $border-radius-md
  margin: $spacing-lg 0

  svg
    max-width: 100%
    height: auto

// Mermaid 错误提示
.mermaid-error
  color: #cc0000
  font-size: $font-size-sm
  padding: $spacing-md
  background: rgba(#cc0000, 0.1)
  border-radius: $border-radius-sm
  margin: $spacing-md 0

// ============================================
// KaTeX - 数学公式样式
// ============================================

// KaTeX 公式显示优化
.katex-display
  overflow-x: auto
  overflow-y: hidden
  padding: $spacing-md 0

  // 防止公式换行导致布局问题
  table
    display: inline-table

// KaTeX 错误样式
.katex-error
  color: #cc0000
  font-family: monospace

// 复制 KaTeX 按钮
.copy-tex
  position: absolute
  top: 0
  right: 0
  padding: 4px 8px
  font-size: 12px
  color: $light-text-tertiary
  background: transparent
  border: none
  cursor: pointer
  opacity: 0
  transition: opacity 0.2s

  &:hover
    color: $primary-color

.katex-block:hover .copy-tex,
.hover\\:show:hover .copy-tex
  opacity: 1

body.dark-theme
  .copy-tex
    color: $dark-text-tertiary

    &:hover
      color: $primary-light

// ============================================
// Medium Zoom - 图片灯箱
// ============================================

.zoom-overlay
  cursor: zoom-out

.zoom-image
  cursor: zoom-out

// 缩放动画
img.zoomable
  cursor: zoom-in
  transition: transform 0.2s ease

  &:hover
    transform: scale(1.02)

// ============================================
// Reading Progress Bar
// ============================================

.reading-progress
  position: fixed
  top: 0
  left: 0
  width: 100%
  z-index: $z-index-fixed
  overflow: hidden

  .reading-progress-bar
    height: 100%
    width: 0
    transition: width 0.1s ease

// ============================================
// Table of Contents (TOC)
// ============================================

.toc-wrapper
  position: sticky
  top: $spacing-xl
  max-height: "calc(100vh - %s)" % ($spacing-xl * 2)
  background: $light-bg-secondary
  border-radius: $border-radius-lg
  padding: $padding-lg
  overflow-y: auto
  font-size: $font-size-sm

  &.toc-right
    order: 2
    margin-left: $spacing-xl

  &.toc-left
    order: 0
    margin-right: $spacing-xl

  .toc-header
    display: flex
    align-items: center
    justify-content: space-between
    margin-bottom: $spacing-md

    .toc-title
      display: flex
      align-items: center
      gap: $spacing-sm
      font-size: $font-size-base
      font-weight: $font-weight-semibold
      color: $light-text-primary
      margin: 0

      svg
        width: 18px
        height: 18px
        color: $primary-color

    .toc-toggle
      background: none
      border: none
      cursor: pointer
      color: $light-text-tertiary
      padding: 0
      transition: transform $transition-base

      svg
        width: 16px
        height: 16px

  .toc-content
    .toc-list
      list-style: none
      padding: 0
      margin: 0

      li
        margin-bottom: $spacing-xs

      a
        display: block
        padding: $padding-xs $padding-sm
        color: $light-text-secondary
        text-decoration: none
        border-left: 2px solid transparent
        transition: all $transition-base

        &:hover
          color: $primary-color
          border-left-color: $primary-color

        &.active
          color: $primary-color
          border-left-color: $primary-color
          font-weight: $font-weight-medium

    .toc-list-number
      counter-reset: toc-counter

      li
        counter-increment: toc-counter

        a::before
          content: counter(toc-counter) ". "
          color: $light-text-tertiary

  &.collapsed .toc-content
    display: none

body.dark-theme
  .toc-wrapper
    background: $dark-bg-secondary

    .toc-title
      color: $dark-text-primary

    .toc-content a
      color: $dark-text-secondary

      &:hover
      &.active
        color: $primary-light
        border-left-color: $primary-light

// ============================================
// Post Navigation
// ============================================

.post-nav
  display: grid
  grid-template-columns: 1fr 1fr
  gap: $spacing-lg
  margin-top: $spacing-2xl
  padding-top: $spacing-xl
  border-top: 1px solid $light-divider

  .post-nav-prev
    text-align: left

  .post-nav-next
    text-align: right

  .nav-link
    display: inline-block
    padding: $padding-lg
    background: $light-bg-secondary
    border-radius: $border-radius-lg
    text-decoration: none
    transition: all $transition-base

    &:hover
      background: rgba($primary-color, 0.1)

      .nav-title
        color: $primary-color

    .nav-label
      display: flex
      align-items: center
      gap: $spacing-xs
      font-size: $font-size-xs
      color: $light-text-tertiary
      margin-bottom: $spacing-xs

      svg
        width: 14px
        height: 14px

    .nav-title
      font-size: $font-size-base
      font-weight: $font-weight-medium
      color: $light-text-primary
      transition: color $transition-base
      display: -webkit-box
      -webkit-line-clamp: 2
      -webkit-box-orient: vertical
      overflow: hidden

body.dark-theme
  .post-nav
    border-top-color: $dark-divider

    .nav-link
      background: $dark-bg-secondary

      &:hover
        background: rgba($primary-light, 0.1)

        .nav-title
          color: $primary-light

      .nav-label
        color: $dark-text-tertiary

      .nav-title
        color: $dark-text-primary

// ============================================
// Article Copyright
// ============================================

.article-copyright
  margin-top: $spacing-xl
  padding: $padding-lg
  background: rgba($primary-color, 0.05)
  border-left: 4px solid $primary-color
  border-radius: 0 $border-radius-md $border-radius-md 0
  font-size: $font-size-sm
  color: $light-text-secondary

body.dark-theme
  .article-copyright
    background: rgba($primary-light, 0.05)
    border-left-color: $primary-light
    color: $dark-text-secondary

// ============================================
// Article Image
// ============================================

.article-image
  margin: $spacing-xl 0

  img
    max-width: 100%
    height: auto
    border-radius: $border-radius-lg

  figcaption
    margin-top: $spacing-sm
    font-size: $font-size-sm
    color: $light-text-tertiary
    text-align: center

body.dark-theme
  .article-image figcaption
    color: $dark-text-tertiary

// ============================================
// Note Tags
// ============================================

.note
  margin: $spacing-lg 0
  padding: $padding-lg
  border-radius: $border-radius-md
  border-left: 4px solid

  .note-content
    p:last-child
      margin-bottom: 0

  &.note-default
    background: $light-bg-secondary
    border-left-color: $light-text-tertiary

  &.note-primary
    background: rgba(#4a90d9, 0.1)
    border-left-color: #4a90d9

  &.note-success
    background: rgba(#52c41a, 0.1)
    border-left-color: #52c41a

  &.note-warning
    background: rgba(#faad14, 0.1)
    border-left-color: #faad14

  &.note-danger
    background: rgba(#ff4d4f, 0.1)
    border-left-color: #ff4d4f

body.dark-theme
  .note
    &.note-default
      background: $dark-bg-secondary
      border-left-color: $dark-text-tertiary

    &.note-primary
      background: rgba($primary-light, 0.1)
      border-left-color: $primary-light

// ============================================
// Timeline
// ============================================

.timeline
  margin: $spacing-xl 0

  .timeline-title
    font-size: $font-size-lg
    font-weight: $font-weight-semibold
    color: $light-text-primary
    margin-bottom: $spacing-lg

  .timeline-content
    position: relative
    padding-left: $spacing-xl

    &::before
      content: ''
      position: absolute
      left: 6px
      top: 0
      bottom: 0
      width: 2px
      background: $light-divider

  .timeline-node
    position: relative
    margin-bottom: $spacing-lg

    &::before
      content: ''
      position: absolute
      left: -(($spacing-xl + 3px))
      top: 6px
      width: 12px
      height: 12px
      background: $primary-color
      border-radius: 50%

    .timeline-node-title
      font-weight: $font-weight-semibold
      color: $light-text-primary
      margin-bottom: $spacing-xs

body.dark-theme
  .timeline
    .timeline-title
      color: $dark-text-primary

    .timeline-content::before
      background: $dark-divider

    .timeline-node::before
      background: $primary-light

    .timeline-node-title
      color: $dark-text-primary

// ============================================
// Folding/Collapse
// ============================================

.folding-block
  margin: $spacing-lg 0
  border: 1px solid $light-border
  border-radius: $border-radius-md
  overflow: hidden

  .folding-title
    display: flex
    align-items: center
    padding: $padding-md $padding-lg
    font-weight: $font-weight-medium
    color: $light-text-primary
    background: $light-bg-secondary
    cursor: pointer
    user-select: none

    &::before
      content: '▶'
      font-size: $font-size-xs
      margin-right: $spacing-sm
      transition: transform $transition-base

  &[open] .folding-title::before
    transform: rotate(90deg)

  .folding-content
    padding: $padding-lg
    border-top: 1px solid $light-border

body.dark-theme
  .folding-block
    border-color: $dark-border

    .folding-title
      color: $dark-text-primary
      background: $dark-bg-secondary

    .folding-content
      border-top-color: $dark-border

// ============================================
// Link Card
// ============================================

.link-card
  display: block
  margin: $spacing-lg 0
  padding: $padding-lg
  background: $light-bg-secondary
  border-radius: $border-radius-lg
  text-decoration: none
  transition: all $transition-base

  &:hover
    background: rgba($primary-color, 0.1)
    transform: translateY(-2px)

  .link-card-content
    .link-title
      font-size: $font-size-base
      font-weight: $font-weight-medium
      color: $light-text-primary
      margin-bottom: $spacing-xs

    .link-desc
      font-size: $font-size-sm
      color: $light-text-secondary
      margin-bottom: $spacing-sm

    .link-url
      font-size: $font-size-xs
      color: $light-text-tertiary

body.dark-theme
  .link-card
    background: $dark-bg-secondary

    &:hover
      background: rgba($primary-light, 0.1)

    .link-title
      color: $dark-text-primary

    .link-desc
      color: $dark-text-secondary

// ============================================
// Badge
// ============================================

.badge
  display: inline-flex
  align-items: center
  padding: $padding-xs $padding-sm
  font-size: $font-size-xs
  font-weight: $font-weight-medium
  border-radius: $border-radius-sm

  &.badge-default
    color: $light-text-secondary
    background: $light-bg-secondary

  &.badge-primary
    color: white
    background: $primary-color

  &.badge-success
    color: white
    background: #52c41a

  &.badge-warning
    color: white
    background: #faad14

  &.badge-danger
    color: white
    background: #ff4d4f

body.dark-theme
  .badge
    &.badge-default
      color: $dark-text-secondary
      background: $dark-bg-secondary

// ============================================
// Tabs - 多标签页切换
// ============================================

.tabs-wrapper
  margin: $spacing-lg 0
  border: 1px solid $light-border
  border-radius: $border-radius-md
  overflow: hidden

.tabs-nav
  display: flex
  flex-wrap: wrap
  background: $light-bg-secondary
  border-bottom: 1px solid $light-border
  padding: 0
  margin: 0

.tab-btn
  padding: $padding-md $padding-lg
  font-size: $font-size-sm
  font-weight: $font-weight-medium
  color: $light-text-secondary
  background: transparent
  border: none
  border-bottom: 2px solid transparent
  cursor: pointer
  transition: all $transition-base
  margin-bottom: -1px

  &:hover
    color: $primary-color

  &.active
    color: $primary-color
    border-bottom-color: $primary-color
    background: $light-bg-primary

.tabs-content
  .tab-pane
    display: none
    padding: $padding-lg

    &.active
      display: block

  // Preserve markdown content styling
  h1, h2, h3, h4, h5, h6
    margin-top: $spacing-lg
    margin-bottom: $spacing-md

  p, ul, ol, pre
    margin-bottom: $spacing-md

  p:last-child
    margin-bottom: 0

body.dark-theme
  .tabs-wrapper
    border-color: $dark-border

  .tabs-nav
    background: $dark-bg-secondary
    border-bottom-color: $dark-border

  .tab-btn
    color: $dark-text-secondary

    &:hover
      color: $primary-light

    &.active
      color: $primary-light
      background: $dark-bg-primary

// ============================================
// Gallery - 图片画廊
// ============================================

.gallery-wrapper
  display: grid
  grid-template-columns: repeat(var(--gallery-cols, 3), 1fr)
  gap: $spacing-md
  margin: $spacing-lg 0

  img
    width: 100%
    height: auto
    border-radius: $border-radius-md
    object-fit: cover
    transition: transform $transition-base

    &:hover
      transform: scale(1.02)

@media (max-width: 768px)
  .gallery-wrapper
    grid-template-columns: repeat(2, 1fr)

// ============================================
// Code Block Enhancement
// ============================================

.code-block-wrapper
  margin: $spacing-lg 0
  border-radius: $border-radius-md
  overflow: hidden
  background: $code-bg
  border: 1px solid $light-border

.code-block-header
  display: flex
  justify-content: space-between
  align-items: center
  padding: $padding-sm $padding-md
  background: darken($code-bg, 5%)
  border-bottom: 1px solid $light-border

  .code-lang
    font-size: $font-size-xs
    font-weight: $font-weight-medium
    color: $light-text-tertiary

// Code Copy Button with SVG Icon
.code-copy-btn
  position: relative
  display: flex
  align-items: center
  justify-content: center
  width: 28px
  height: 28px
  padding: 0
  color: $light-text-tertiary
  background: transparent
  border: 1px solid $light-border
  border-radius: $border-radius-sm
  cursor: pointer
  transition: all $transition-base

  // Hide icons by default
  .copy-icon,
  .check-icon
    display: none

  // Show copy icon by default
  .copy-icon
    display: block

  // Hover state
  &:hover
    color: $primary-color
    border-color: $primary-color

  // Copied state
  &[data-copy-state='copied'],
  &.copied
    color: #52c41a
    border-color: #52c41a

    .copy-icon
      display: none
    .check-icon
      display: block

  // Error state
  &[data-copy-state='error'],
  &.error
    color: #ff4d4f
    border-color: #ff4d4f

.code-block
  margin: 0
  padding: $padding-lg
  overflow-x: auto
  font-size: $font-size-sm
  line-height: $line-height-base

body.dark-theme
  .code-block-wrapper
    border-color: $dark-border

  .code-block-header
    background: lighten($code-bg-dark, 5%)

    .code-lang
      color: $dark-text-tertiary

  .code-copy-btn
    color: $dark-text-tertiary
    border-color: $dark-border

    &:hover
      color: $primary-color
      border-color: $primary-color

// ============================================
// Label Enhancement
// ============================================

.label
  display: inline
  padding: 2px 8px
  font-size: 0.875em
  font-weight: $font-weight-medium
  border-radius: $border-radius-sm
  background: $light-bg-secondary
  color: $light-text-primary

  &.label-primary
    background: rgba($primary-color, 0.15)
    color: $primary-color

  &.label-success
    background: rgba(#52c41a, 0.15)
    color: #52c41a

  &.label-warning
    background: rgba(#faad14, 0.15)
    color: #faad14

  &.label-danger
    background: rgba(#ff4d4f, 0.15)
    color: #ff4d4f

  &.label-info
    background: rgba(#1890ff, 0.15)
    color: #1890ff

body.dark-theme
  .label
    background: $dark-bg-secondary
    color: $dark-text-primary

    &.label-primary
      background: rgba($primary-light, 0.15)
      color: $primary-light

// ============================================
// Table Wrapper - 响应式表格
// ============================================

.table-wrapper
  overflow-x: auto
  margin: $spacing-lg 0
  border-radius: $border-radius-md
  border: 1px solid $light-border

  table
    margin: 0
    min-width: 100%

  // Preserve table styles from _components.styl
  th, td
    white-space: nowrap

body.dark-theme
  .table-wrapper
    border-color: $dark-border

// ============================================
// Video & Audio Player
// ============================================

.video-player,
.audio-player
  max-width: 100%
  margin: $spacing-lg 0
  border-radius: $border-radius-md

.video-player
  width: 100%
  height: auto

.audio-player
  width: 100%
  height: 40px

// ============================================
// Grid Layout
// ============================================

.grid-layout
  display: grid
  gap: $spacing-lg
  margin: $spacing-lg 0

  &.grid-cols-2
    grid-template-columns: repeat(2, 1fr)

  &.grid-cols-3
    grid-template-columns: repeat(3, 1fr)

  &.grid-cols-4
    grid-template-columns: repeat(4, 1fr)

@media (max-width: 768px)
  .grid-layout
    grid-template-columns: 1fr !important

// ============================================
// Text Align Wrapper
// ============================================

.align-wrapper
  margin: $spacing-lg 0

// ============================================
// Banner - 首页 Banner
// ============================================

.banner-wrapper
  position: relative
  display: flex
  align-items: center
  justify-content: center
  width: 100%
  overflow: hidden
  background: $light-bg-secondary

  // Banner 背景图片
  .banner-img
    position: absolute
    top: 0
    left: 0
    width: 100%
    height: 100%
    background-size: cover
    background-position: center
    background-repeat: no-repeat
    z-index: 1

    // 视差效果
    .parallax &
      background-attachment: fixed

      @media (max-width: 768px)
        background-attachment: scroll

  // 遮罩层
  .banner-mask
    position: absolute
    top: 0
    left: 0
    width: 100%
    height: 100%
    background: #000
    z-index: 2

  // Banner 内容
  .banner-content
    position: relative
    z-index: 3
    text-align: center
    color: #fff
    padding: $spacing-2xl

    .banner-title
      font-size: 3rem
      font-weight: $font-weight-bold
      margin-bottom: $spacing-md
      text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3)

    .banner-subtitle
      font-size: 1.25rem
      font-weight: $font-weight-normal
      opacity: 0.9
      min-height: 1.5em

      // 打字机光标
      .typing-cursor
        display: inline-block
        animation: typingCursor 1s infinite
        margin-left: 2px

    // 向下滚动箭头
    .scroll-down-arrow
      position: absolute
      bottom: $spacing-2xl
      left: 50%
      transform: translateX(-50%)
      animation: scrollDownBounce 2s infinite
      cursor: pointer
      opacity: 0.7
      transition: opacity 0.3s

      &:hover
        opacity: 1

// 打字机光标闪烁动画
@keyframes typingCursor
  0%, 100%
    opacity: 1
  50%
    opacity: 0

// 向下箭头弹跳动画
@keyframes scrollDownBounce
  0%, 20%, 50%, 80%, 100%
    transform: translateX(-50%) translateY(0)
  40%
    transform: translateX(-50%) translateY(-10px)
  60%
    transform: translateX(-50%) translateY(-5px)

@media (max-width: 768px)
  .banner-wrapper
    .banner-content
      .banner-title
        font-size: 2rem

      .banner-subtitle
        font-size: 1rem

// ============================================
// Copyright - 版权声明
// ============================================

.copyright-wrapper
  margin: $spacing-2xl 0 $spacing-lg
  padding: $spacing-lg $spacing-xl
  background: var(--color-bg-secondary)
  border-radius: $border-radius-md
  border-left: 4px solid var(--color-primary)

  .copyright-title
    font-size: $font-size-base
    font-weight: $font-weight-bold
    margin-bottom: $spacing-sm
    color: var(--color-text-primary)

  .copyright-content
    font-size: $font-size-sm
    color: var(--color-text-secondary)
    line-height: 1.8

    a
      color: var(--color-primary)
      text-decoration: none

      &:hover
        text-decoration: underline

    .copyright-item
      margin: $spacing-xs 0

      .copyright-label
        font-weight: $font-weight-medium
        margin-right: $spacing-sm

      .copyright-value
        color: var(--color-text-primary)

  .copyright-license
    margin-top: $spacing-md
    padding-top: $spacing-md
    border-top: 1px solid var(--color-border)

    .license-icon
      display: inline-flex
      align-items: center
      gap: $spacing-xs
      font-size: $font-size-sm
      color: var(--color-text-secondary)

      svg
        width: 20px
        height: 20px

// ============================================
// Page 404
// ============================================

.page-404
  display: flex
  flex-direction: column
  align-items: center
  justify-content: center
  min-height: 60vh
  text-align: center
  padding: $spacing-2xl

  .error-code
    font-size: 8rem
    font-weight: $font-weight-bold
    color: var(--color-primary)
    line-height: 1
    margin-bottom: $spacing-md
    text-shadow: 0 0 30px rgba($primary-color, 0.3)

    body.dark-theme &
      text-shadow: 0 0 30px rgba($primary-light, 0.3)

  .error-title
    font-size: 1.5rem
    font-weight: $font-weight-bold
    margin-bottom: $spacing-sm
    color: var(--color-text-primary)

  .error-desc
    font-size: $font-size-base
    color: var(--color-text-secondary)
    margin-bottom: $spacing-xl

  .error-actions
    display: flex
    gap: $spacing-md

    .error-btn
      display: inline-flex
      align-items: center
      padding: $spacing-sm $spacing-lg
      border-radius: $border-radius-md
      font-size: $font-size-base
      font-weight: $font-weight-medium
      text-decoration: none
      transition: all 0.3s ease

      &.btn-primary
        background: var(--color-primary)
        color: #fff

        &:hover
          background: var(--color-primary-dark)
          transform: translateY(-2px)

      &.btn-secondary
        background: var(--color-bg-secondary)
        color: var(--color-text-primary)
        border: 1px solid var(--color-border)

        &:hover
          background: var(--color-bg-hover)

  .error-countdown
    margin-top: $spacing-lg
    font-size: $font-size-sm
    color: var(--color-text-tertiary)

// ============================================
// About Page - 关于页面
// ============================================

.about-page
  .about-header
    text-align: center
    padding: $spacing-2xl 0

    .about-avatar
      width: 120px
      height: 120px
      border-radius: 50%
      object-fit: cover
      margin-bottom: $spacing-lg
      border: 4px solid var(--color-primary)
      box-shadow: 0 4px 20px rgba($primary-color, 0.2)

    .about-name
      font-size: 1.75rem
      font-weight: $font-weight-bold
      margin-bottom: $spacing-sm
      color: var(--color-text-primary)

    .about-intro
      font-size: $font-size-base
      color: var(--color-text-secondary)
      max-width: 500px
      margin: 0 auto

  .about-icons
    display: flex
    justify-content: center
    gap: $spacing-md
    margin-top: $spacing-xl

    .about-icon-link
      display: flex
      align-items: center
      justify-content: center
      width: 44px
      height: 44px
      border-radius: 50%
      background: var(--color-bg-secondary)
      color: var(--color-text-secondary)
      font-size: 1.25rem
      text-decoration: none
      transition: all 0.3s ease

      &:hover
        background: var(--color-primary)
        color: #fff
        transform: translateY(-3px)

// ============================================
// Category & Tag Page Styles
// 参考 Fluid 主题设计
// ============================================

// Category Page
.categories-container
  margin: $spacing-2xl 0

.categories-list
  display: grid
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr))
  gap: $spacing-lg

.category-item
  background: var(--color-card-bg)
  border: 1px solid var(--color-border)
  border-radius: $border-radius-lg
  padding: $spacing-lg
  transition: transform $transition-base, box-shadow $transition-base

  &:hover
    transform: translateY(-2px)
    box-shadow: $shadow-md

.category-title
  display: flex
  align-items: center
  justify-content: space-between
  margin: 0 0 $spacing-md 0
  font-size: $font-size-lg

  a
    color: var(--color-text)
    text-decoration: none

    &:hover
      color: var(--color-primary)

.category-count
  font-size: $font-size-sm
  color: var(--color-text-tertiary)
  background: var(--color-bg-secondary)
  padding: $spacing-xs $spacing-sm
  border-radius: $border-radius-sm

.category-posts
  margin-top: $spacing-md

  .post-item
    display: flex
    align-items: center
    justify-content: space-between
    padding: $spacing-sm 0
    border-bottom: 1px solid var(--color-border-light)

    &:last-child
      border-bottom: none

  .post-link
    color: var(--color-text-secondary)
    text-decoration: none
    font-size: $font-size-sm

    &:hover
      color: var(--color-primary)

  .post-date
    font-size: $font-size-xs
    color: var(--color-text-tertiary)

// Tag Page
.tags-container
  margin: $spacing-2xl 0

.tag-cloud
  display: flex
  flex-wrap: wrap
  gap: $spacing-sm
  justify-content: center
  padding: $spacing-xl 0

.tag-link
  display: inline-block
  padding: $spacing-xs $spacing-md
  border-radius: $border-radius-md
  text-decoration: none
  color: var(--color-text-secondary)
  background: var(--color-bg-secondary)
  border: 1px solid var(--color-border)
  transition: all $transition-base

  &:hover
    color: var(--color-primary)
    border-color: var(--color-primary)
    transform: translateY(-2px)

  // Tag size classes
  &.tag-size-1
    font-size: $font-size-sm

  &.tag-size-2
    font-size: $font-size-base

  &.tag-size-3
    font-size: $font-size-lg

  &.tag-size-4
    font-size: $font-size-xl

  &.tag-size-5
    font-size: $font-size-2xl

.tags-list
  margin-top: $spacing-2xl

.tag-section
  margin-bottom: $spacing-xl
  padding-bottom: $spacing-xl
  border-bottom: 1px solid var(--color-border-light)

  &:last-child
    border-bottom: none

.tag-title
  display: flex
  align-items: center
  gap: $spacing-sm
  margin: 0 0 $spacing-md 0
  font-size: $font-size-xl

  a
    color: var(--color-text)
    text-decoration: none

    &:hover
      color: var(--color-primary)

.tag-posts
  .post-item
    display: flex
    align-items: center
    justify-content: space-between
    padding: $spacing-sm 0

  .post-link
    color: var(--color-text-secondary)
    text-decoration: none

    &:hover
      color: var(--color-primary)

  .post-date
    font-size: $font-size-sm
    color: var(--color-text-tertiary)

// Archive Page Enhancement
.archive-container
  margin: $spacing-2xl 0

.archive-year
  margin-bottom: $spacing-2xl

.year-title
  display: flex
  align-items: center
  gap: $spacing-sm
  margin: 0 0 $spacing-lg 0
  font-size: $font-size-2xl
  color: var(--color-text)

.year-count
  font-size: $font-size-sm
  color: var(--color-text-tertiary)

.archive-posts
  border-left: 2px solid var(--color-border)
  padding-left: $spacing-lg

.archive-item
  display: flex
  align-items: baseline
  gap: $spacing-md
  padding: $spacing-sm 0

.archive-date
  font-size: $font-size-sm
  color: var(--color-text-tertiary)
  white-space: nowrap
  min-width: 60px

.archive-title
  color: var(--color-text-secondary)
  text-decoration: none

  &:hover
    color: var(--color-primary)

// ============================================
// Read Mode - 阅读模式
// ============================================

body.read-mode
  // 隐藏不必要的元素
  .sidebar,
  #header,
  #footer,
  .post-nav,
  .comments-wrapper,
  .toc-wrapper,
  #rightside-config-hide,
  .article-tags,
  .article-meta
    display: none !important

  // 调整内容宽度
  .main-content
    padding: 0

  .container
    max-width: 720px

  .article-container
    max-width: 720px
    margin: 0 auto
    padding: $spacing-2xl 0

  // 隐藏背景效果
  .starry-background,
  .bg-canvas
    display: none

  // 恢复阅读模式按钮
  #rightside-config-hide
    display: flex !important
    opacity: 1 !important
    visibility: visible !important
    transform: none !important

  // 阅读模式按钮样式
  .read-mode
    background: var(--color-primary)
    border-color: var(--color-primary)
    color: white

    &:hover
      background: var(--color-primary-dark)
      border-color: var(--color-primary-dark)

// ============================================
// Links - 友链页面
// ============================================

.links-container
  margin: $spacing-2xl 0

.links-grid
  display: grid
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr))
  gap: $spacing-lg

  // 友链卡片
  .link-card
    display: flex
    align-items: center
    padding: $spacing-md $spacing-lg
    background: var(--color-card-bg)
    border: 1px solid var(--color-border)
    border-radius: $radius-lg
    transition: all 0.3s ease
    text-decoration: none
    color: var(--color-text)

    &:hover
      transform: translateY(-4px)
      box-shadow: 0 8px 24px var(--color-shadow-hover)
      border-color: var(--color-primary)

  // 友链头像
  .link-avatar
    flex-shrink: 0
    width: 60px
    height: 60px
    margin-right: $spacing-md
    border-radius: 50%
    overflow: hidden
    background: var(--color-bg-secondary)
    display: flex
    align-items: center
    justify-content: center

    img
      width: 100%
      height: 100%
      object-fit: cover

    // 头像占位符
    .link-avatar-placeholder
      width: 100%
      height: 100%
      display: flex
      align-items: center
      justify-content: center
      font-size: 1.5rem
      font-weight: 600
      color: var(--color-text-secondary)
      background: var(--color-bg-secondary)

  // 友链信息
  .link-info
    flex: 1
    min-width: 0

  .link-title
    margin: 0 0 $spacing-xs 0
    font-size: 1.1rem
    font-weight: 600
    color: var(--color-text)
    transition: color 0.3s ease

  .link-intro
    margin: 0
    font-size: 0.875rem
    color: var(--color-text-secondary)
    line-height: 1.5
    // 多行截断
    display: -webkit-box
    -webkit-line-clamp: 2
    -webkit-box-orient: vertical
    overflow: hidden

// 友链自定义内容
.links-custom
  margin-top: $spacing-2xl
  padding-top: $spacing-xl
  border-top: 1px solid var(--color-border)

// ============================================
// Footnotes - 脚注
// ============================================

.footnotes
  margin-top: $spacing-2xl
  padding-top: $spacing-xl
  border-top: 1px solid var(--color-border)

  .footnotes-header
    margin: 0 0 $spacing-md 0
    font-size: 1.1rem
    font-weight: 600
    color: var(--color-text)

  .footnotes-list
    margin: 0
    padding-left: $spacing-lg

    .footnote-item
      margin-bottom: $spacing-sm
      font-size: 0.875rem
      color: var(--color-text-secondary)
      line-height: 1.6

      .footnote-backref
        margin-left: $spacing-xs
        text-decoration: none
        color: var(--color-primary)

        &:hover
          color: var(--color-primary-dark)

// 脚注引用
.footnote-ref
  a
    text-decoration: none
    color: var(--color-primary)
    font-size: 0.8rem
    vertical-align: super

    &:hover
      color: var(--color-primary-dark)
