// Hexo Theme Almagest - Design Variables
// ======================================

// ============================================
// Color Variables
// ============================================

// Light Theme Colors
// 「月白」冷调亮色：偏蓝的低饱和灰阶，避免纯白的刺眼感
$light-bg-primary = #fbfcfe
$light-bg-secondary = #f4f6fb
$light-bg-tertiary = #e9edf6
$light-text-primary = #1c2233
$light-text-secondary = #5a6274
$light-text-tertiary = #8b93a6
$light-border = #dfe4ef
$light-divider = #eef1f7

// Dark Theme Colors
// 「深空」暗色：接近纯黑并带蓝紫冷调，呼应星野底色
$dark-bg-primary = #05070f
$dark-bg-secondary = #0b0f1d
$dark-bg-tertiary = #131829
$dark-text-primary = #e6ecf7
$dark-text-secondary = #9aa6bf
$dark-text-tertiary = #6b7691
$dark-border = #1e2740
$dark-divider = #141a2b

// Accent Colors (used in both themes)
// 星蓝 -> 星紫 强调体系，取自星野志的深空调色板
//
// ⚠️ 双轨制规则（C1 修复后）：
// - 编译期变量（$primary-color 等）：只允许用于**装饰性**元素
//   （渐变、玻璃态、星辉发光等两主题通用的视觉氛围）。
// - **主题感知表面**（按钮、链接、active 态、复制按钮等需要随明暗切换的
//   交互元素）一律改用运行时 CSS 变量：`var(--color-button-primary-bg)`、
//   `var(--color-link)` 等，由 `_theme-light.styl` / `_theme-dark.styl` 提供。
//   否则亮色主题会出现「浅青底白字」这类对比度缺陷，且与靛蓝链接色并存。
$primary-color = #67e8f9
$primary-light = #8ef0fb
$primary-dark = #38bdf8
$secondary-color = #818cf8
$accent-2 = #818cf8
$accent-3 = #a78bfa
$accent-4 = #c084fc
$success-color = #34d399
$warning-color = #fbbf24
$danger-color = #f87171
$info-color = #67e8f9

// Code Highlight Colors（亮色代码块：深色文字 + 冷调底）
$code-bg = #f4f6fb
$code-text = #1c2233
$code-keyword = #4f46e5
$code-string = #0f766e
$code-comment = #8b93a6
$code-number = #c2410c
$code-function = #0369a1
$code-attr = #7c3aed

// ============================================
// Font Variables
// ============================================

// Font Families
$font-family-base = -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif
$font-family-heading = $font-family-base
$font-family-code = 'Monaco', 'Menlo', 'Ubuntu Mono', 'Consolas', 'source-code-pro', monospace
$font-family-serif = 'Georgia', 'Garamond', 'Times New Roman', serif

// Font Sizes
$font-size-base = 16px
$font-size-sm = 14px
$font-size-xs = 12px
$font-size-lg = 18px
$font-size-xl = 20px
$font-size-2xl = 24px
$font-size-3xl = 28px
$font-size-4xl = 32px

// Font Weights
$font-weight-light = 300
$font-weight-normal = 400
$font-weight-medium = 500
$font-weight-semibold = 600
$font-weight-bold = 700
$font-weight-extrabold = 800

// Line Heights
$line-height-tight = 1.2
$line-height-normal = 1.5
$line-height-relaxed = 1.75
$line-height-loose = 2

// Letter Spacing
$letter-spacing-tight = -0.02em
$letter-spacing-normal = 0
$letter-spacing-wide = 0.02em
$letter-spacing-wider = 0.05em

// ============================================
// Spacing Variables
// ============================================

// Base Spacing Unit (1rem = 16px)
$spacing-unit = 1rem

// Spacing Scale
$spacing-xs = 0.25rem    // 4px
$spacing-sm = 0.5rem     // 8px
$spacing-md = 1rem       // 16px
$spacing-lg = 1.5rem     // 24px
$spacing-xl = 2rem       // 32px
$spacing-2xl = 3rem      // 48px
$spacing-3xl = 4rem      // 64px
$spacing-4xl = 6rem      // 96px

// Padding
$padding-xs = $spacing-xs
$padding-sm = $spacing-sm
$padding-md = $spacing-md
$padding-lg = $spacing-lg
$padding-xl = $spacing-xl

// Margin
$margin-xs = $spacing-xs
$margin-sm = $spacing-sm
$margin-md = $spacing-md
$margin-lg = $spacing-lg
$margin-xl = $spacing-xl
$margin-2xl = $spacing-2xl
$margin-3xl = $spacing-3xl
$margin-4xl = $spacing-4xl

// 兼容别名：部分样式文件使用 $space-* 命名
// 注意：Stylus 变量按值传递，此处别名是赋值时的快照。
// 别名「只读」，请修改上方源变量（$spacing-* / $*-color 等），
// 不要直接改别名，否则两套命名会漂移导致样式不一致。
$space-xs = $spacing-xs
$space-sm = $spacing-sm
$space-md = $spacing-md
$space-lg = $spacing-lg
$space-xl = $spacing-xl
$space-2xl = $spacing-2xl
$space-3xl = $spacing-3xl
$space-4xl = $spacing-4xl

// 颜色别名：$color-* 等价于 $*-color 命名（同样「只读」，请修改源变量）
$color-primary = $primary-color
$color-primary-light = $primary-light
$color-primary-dark = $primary-dark
$color-secondary = $secondary-color
$color-success = $success-color
$color-warning = $warning-color
$color-danger = $danger-color
$color-info = $info-color
$color-accent-2 = $accent-2
$color-accent-3 = $accent-3
$color-accent-4 = $accent-4

// Gap (for flexbox/grid)
$gap-xs = $spacing-xs
$gap-sm = $spacing-sm
$gap-md = $spacing-md
$gap-lg = $spacing-lg
$gap-xl = $spacing-xl

// ============================================
// Border Variables
// ============================================

$border-radius-sm = 4px
$border-radius-md = 8px
$border-radius-lg = 12px
$border-radius-xl = 16px
$border-radius-full = 9999px

$border-width-thin = 1px
$border-width-normal = 2px
$border-width-thick = 3px

// ============================================
// Shadow Variables
// ============================================

// 亮色主题阴影：冷调中性黑，保持轻盈
$shadow-sm = 0 1px 2px 0 rgba(22, 30, 51, 0.05)
$shadow-md = 0 4px 6px -1px rgba(22, 30, 51, 0.08), 0 2px 4px -1px rgba(22, 30, 51, 0.05)
$shadow-lg = 0 10px 15px -3px rgba(22, 30, 51, 0.1), 0 4px 6px -2px rgba(22, 30, 51, 0.05)
$shadow-xl = 0 20px 25px -5px rgba(22, 30, 51, 0.12), 0 10px 10px -5px rgba(22, 30, 51, 0.04)

// 深空阴影：大范围负扩散，模拟悬浮在真空中的层次感
$shadow-deep-sm = 0 8px 24px -12px rgba(0, 0, 0, 0.7)
$shadow-deep-md = 0 18px 50px -20px rgba(0, 0, 0, 0.85)
$shadow-deep-lg = 0 30px 80px -30px rgba(0, 0, 0, 0.9)

// 星辉：强调色外发光，用于 hover / focus 状态
$glow-primary = 0 0 0 1px rgba(103, 232, 249, 0.18), 0 8px 32px -12px rgba(103, 232, 249, 0.45)
$glow-primary-soft = 0 8px 40px -18px rgba(103, 232, 249, 0.35)
$glow-violet = 0 8px 40px -18px rgba(167, 139, 250, 0.4)

// 玻璃态卡片底/边框（配合 backdrop-filter 使用）
$glass-bg = rgba(19, 24, 41, 0.55)
$glass-border = rgba(137, 160, 214, 0.14)

// ============================================
// Gradient Variables
// ============================================

// 星野渐变：星蓝 -> 靛蓝 -> 星紫
$grad-primary = linear-gradient(120deg, #67e8f9 0%, #818cf8 55%, #c084fc 100%)
$grad-primary-soft = linear-gradient(120deg, rgba(103, 232, 249, 0.14) 0%, rgba(129, 140, 248, 0.14) 50%, rgba(192, 132, 252, 0.14) 100%)
$grad-text = linear-gradient(120deg, #67e8f9 0%, #818cf8 55%, #c084fc 100%)
$grad-surface = linear-gradient(180deg, rgba(103, 232, 249, 0.06) 0%, rgba(167, 139, 250, 0.04) 100%)

// 星云光晕：用于页面装饰性径向渐变
$nebula-a = radial-gradient(60% 60% at 15% 10%, rgba(103, 232, 249, 0.1) 0%, transparent 70%)
$nebula-b = radial-gradient(50% 50% at 85% 20%, rgba(167, 139, 250, 0.1) 0%, transparent 70%)

// ============================================
// Transition Variables
// ============================================

$transition-fast = 150ms ease-in-out
$transition-base = 250ms ease-in-out
$transition-slow = 350ms ease-in-out

// ============================================
// Breakpoint Variables
// ============================================

$breakpoint-xs = 0
$breakpoint-sm = 576px
$breakpoint-md = 768px
$breakpoint-lg = 992px
$breakpoint-xl = 1200px
$breakpoint-2xl = 1400px

// ============================================
// Z-Index Variables
// ============================================

$z-index-dropdown = 1000
$z-index-sticky = 1020
$z-index-fixed = 1030
$z-index-modal-backdrop = 1040
$z-index-modal = 1050
$z-index-popover = 1060
$z-index-tooltip = 1070

// ============================================
// Container Variables
// ============================================

$container-width-sm = 540px
$container-width-md = 720px
$container-width-lg = 960px
$container-width-xl = 1140px
$container-width-2xl = 1320px

// ============================================
// Animation Variables
// ============================================

$animation-duration-fast = 150ms
$animation-duration-base = 250ms
$animation-duration-slow = 350ms

$animation-timing-ease-in = ease-in
$animation-timing-ease-out = ease-out
$animation-timing-ease-in-out = ease-in-out
$animation-timing-linear = linear
