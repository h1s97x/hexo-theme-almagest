// ============================================================
// Light Theme
// ============================================================

:root,
[data-theme='light']
  // Background Colors —— 月白冷调
  --color-bg: #fbfcfe
  --color-bg-secondary: #f4f6fb
  --color-hover-bg: #e9edf6
  --color-bg-elevated: #ffffff

  // Text Colors
  --color-text: #1c2233
  --color-text-secondary: #5a6274
  --color-text-tertiary: #8b93a6

  // Border Colors
  --color-border: #dfe4ef
  --color-border-light: #eef1f7

  // Code Colors
  --color-code-bg: #f4f6fb
  --color-code-text: #1c2233
  --color-code-keyword: #4f46e5
  --color-code-string: #0f766e
  --color-code-comment: #8b93a6
  --color-code-number: #c2410c
  --color-code-function: #0369a1
  --color-code-attr: #7c3aed

  // Table Colors
  --color-table-header-bg: #f4f6fb
  --color-table-row-hover: #eef1f7
  --color-table-border: #dfe4ef

  // Input Colors
  --color-input-bg: #ffffff
  --color-input-border: #dfe4ef
  --color-input-focus: #4f46e5

  // Tag Colors
  --color-tag-bg: rgba(79, 70, 229, 0.08)
  --color-tag-text: #4f46e5
  --color-tag-border: rgba(79, 70, 229, 0.18)

  // Link Colors
  --color-link: #4f46e5
  --color-link-hover: #6366f1
  --color-link-active: #4338ca
  --color-link-accent: #7c3aed

  // Button Colors
  --color-button-primary-bg: #4f46e5
  --color-button-primary-text: #ffffff
  --color-button-primary-hover: #6366f1

  // Accent / Gradient Colors
  --color-accent: #4f46e5
  --color-accent-2: #4f46e5
  --color-accent-3: #7c3aed
  --color-accent-4: #a855f7
  --grad-primary: linear-gradient(120deg, #0891b2 0%, #4f46e5 55%, #7c3aed 100%)
  --grad-text: linear-gradient(120deg, #0891b2 0%, #4f46e5 55%, #7c3aed 100%)

  // Surface / Glass
  --color-glass-bg: rgba(255, 255, 255, 0.72)
  --color-glass-border: rgba(79, 70, 229, 0.12)
  --color-glass-blur: 18px

  // Alert Colors
  --color-alert-success-bg: rgba(16, 185, 129, 0.1)
  --color-alert-success-text: #065f46
  --color-alert-warning-bg: rgba(245, 158, 11, 0.12)
  --color-alert-warning-text: #92400e
  --color-alert-danger-bg: rgba(239, 68, 68, 0.1)
  --color-alert-danger-text: #991b1b
  --color-alert-info-bg: rgba(8, 145, 178, 0.1)
  --color-alert-info-text: #155e75

  // Shadow / Glow Colors
  --color-shadow: rgba(22, 30, 51, 0.08)
  --color-shadow-dark: rgba(22, 30, 51, 0.14)
  --shadow-card: 0 10px 30px -12px rgba(22, 30, 51, 0.14)
  --shadow-card-hover: 0 22px 50px -20px rgba(22, 30, 51, 0.2)
  --glow-primary: 0 0 0 1px rgba(79, 70, 229, 0.15), 0 8px 28px -12px rgba(79, 70, 229, 0.3)
  --glow-soft: 0 8px 32px -16px rgba(79, 70, 229, 0.25)

// ============================================================
// Light Theme Specific Styles
// ============================================================

@media (prefers-color-scheme: light)
  :root:not([data-theme])
    // Background Colors —— 月白冷调
    --color-bg: #fbfcfe
    --color-bg-secondary: #f4f6fb
    --color-hover-bg: #e9edf6
    --color-bg-elevated: #ffffff

    // Text Colors
    --color-text: #1c2233
    --color-text-secondary: #5a6274
    --color-text-tertiary: #8b93a6

    // Border Colors
    --color-border: #dfe4ef
    --color-border-light: #eef1f7

    // Code Colors
    --color-code-bg: #f4f6fb
    --color-code-text: #1c2233
    --color-code-keyword: #4f46e5
    --color-code-string: #0f766e
    --color-code-comment: #8b93a6
    --color-code-number: #c2410c
    --color-code-function: #0369a1
    --color-code-attr: #7c3aed

    // Table Colors
    --color-table-header-bg: #f4f6fb
    --color-table-row-hover: #eef1f7
    --color-table-border: #dfe4ef

    // Input Colors
    --color-input-bg: #ffffff
    --color-input-border: #dfe4ef
    --color-input-focus: #4f46e5

    // Tag Colors
    --color-tag-bg: rgba(79, 70, 229, 0.08)
    --color-tag-text: #4f46e5
    --color-tag-border: rgba(79, 70, 229, 0.18)

    // Link Colors
    --color-link: #4f46e5
    --color-link-hover: #6366f1
    --color-link-active: #4338ca
    --color-link-accent: #7c3aed

    // Button Colors
    --color-button-primary-bg: #4f46e5
    --color-button-primary-text: #ffffff
    --color-button-primary-hover: #6366f1

    // Accent / Gradient Colors
    --color-accent: #4f46e5
    --color-accent-2: #4f46e5
    --color-accent-3: #7c3aed
    --color-accent-4: #a855f7
    --grad-primary: linear-gradient(120deg, #0891b2 0%, #4f46e5 55%, #7c3aed 100%)
    --grad-text: linear-gradient(120deg, #0891b2 0%, #4f46e5 55%, #7c3aed 100%)

    // Surface / Glass
    --color-glass-bg: rgba(255, 255, 255, 0.72)
    --color-glass-border: rgba(79, 70, 229, 0.12)
    --color-glass-blur: 18px

    // Alert Colors
    --color-alert-success-bg: rgba(16, 185, 129, 0.1)
    --color-alert-success-text: #065f46
    --color-alert-warning-bg: rgba(245, 158, 11, 0.12)
    --color-alert-warning-text: #92400e
    --color-alert-danger-bg: rgba(239, 68, 68, 0.1)
    --color-alert-danger-text: #991b1b
    --color-alert-info-bg: rgba(8, 145, 178, 0.1)
    --color-alert-info-text: #155e75

    // Shadow / Glow Colors
    --color-shadow: rgba(22, 30, 51, 0.08)
    --color-shadow-dark: rgba(22, 30, 51, 0.14)
    --shadow-card: 0 10px 30px -12px rgba(22, 30, 51, 0.14)
    --shadow-card-hover: 0 22px 50px -20px rgba(22, 30, 51, 0.2)
    --glow-primary: 0 0 0 1px rgba(79, 70, 229, 0.15), 0 8px 28px -12px rgba(79, 70, 229, 0.3)
    --glow-soft: 0 8px 32px -16px rgba(79, 70, 229, 0.25)

// ============================================================
// Light Theme Component Styles
// ============================================================

[data-theme='light']
  // Links
  a
    color: var(--color-link)

    &:hover
      color: var(--color-link-hover)

    &:active
      color: var(--color-link-active)

  // Buttons
  button
  .button
    background-color: var(--color-button-primary-bg)
    color: var(--color-button-primary-text)

    &:hover
      background-color: var(--color-button-primary-hover)

  // Code blocks
  code
  pre
    background-color: var(--color-code-bg)
    color: var(--color-code-text)

  // Tables
  table
    border-color: var(--color-table-border)

    thead
      background-color: var(--color-table-header-bg)

    tbody tr:hover
      background-color: var(--color-table-row-hover)

  // Inputs
  input
  select
  textarea
    background-color: var(--color-input-bg)
    border-color: var(--color-input-border)
    color: var(--color-text)

    &:focus
      border-color: var(--color-input-focus)
      box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.12)

  // Tags
  .tag
    background-color: var(--color-tag-bg)
    color: var(--color-tag-text)
    border-color: var(--color-tag-border)

  // Alerts
  .alert
    &.alert-success
      background-color: var(--color-alert-success-bg)
      color: var(--color-alert-success-text)

    &.alert-warning
      background-color: var(--color-alert-warning-bg)
      color: var(--color-alert-warning-text)

    &.alert-danger
      background-color: var(--color-alert-danger-bg)
      color: var(--color-alert-danger-text)

    &.alert-info
      background-color: var(--color-alert-info-bg)
      color: var(--color-alert-info-text)

  // Blockquotes
  blockquote
    background-color: var(--color-bg-secondary)
    border-left-color: var(--color-link)
    color: var(--color-text-secondary)

  // Cards
  .card
    background-color: var(--color-bg)
    border-color: var(--color-border)
    box-shadow: 0 1px 3px var(--color-shadow)


