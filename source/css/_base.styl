// Hexo Theme Almagest - Base Styles
// =================================

// ============================================
// CSS Reset and Normalization
// ============================================

*
*::before
*::after
  box-sizing: border-box

html
  font-size: $font-size-base
  -webkit-font-smoothing: antialiased
  -moz-osx-font-smoothing: grayscale

body
  margin: 0
  padding: 0
  font-family: $font-family-base
  font-size: $font-size-base
  font-weight: $font-weight-normal
  line-height: $line-height-normal
  color: var(--color-text)
  background-color: var(--color-bg)
  transition: background-color $transition-base, color $transition-base

// 深空底：在底色之上叠几团星云光晕（固定定位，随滚动不动）
// 层级规划（自下而上）：
//   html 底色 < html::before 星云(0) < .starry-background 星空(1) < .app-container 内容(2)
// 注意：.starry-background 必须位于内容之下、底色之上；
// 若内容容器带不透明背景或 z-index 更高，星空就会被整片盖住。
html
  background-color: var(--color-bg)

  &::before
    content: ''
    position: fixed
    inset: 0
    z-index: 0
    pointer-events: none
    background-image: radial-gradient(60% 55% at 12% 4%, rgba(103, 232, 249, 0.07) 0%, transparent 70%), radial-gradient(50% 45% at 88% 12%, rgba(167, 139, 250, 0.07) 0%, transparent 70%), radial-gradient(70% 50% at 50% 105%, rgba(129, 140, 248, 0.05) 0%, transparent 75%)

  // 亮色主题淡化星云（否则浅底会显脏）
  &[data-theme='light']::before
    opacity: 0.5

  &:not([data-theme])::before
    opacity: 0.5

@media (prefers-color-scheme: dark)
  html:not([data-theme])::before
    opacity: 1

// 内容容器：位于星空之上，且自身必须透明，
// 否则会遮住 canvas 星空（透明底也让星云透出来）
.app-container
  position: relative
  z-index: 2
  background-color: transparent

// ============================================
// Typography - Headings
// ============================================

h1
h2
h3
h4
h5
h6
  margin: $margin-lg 0 $margin-md 0
  font-family: $font-family-heading
  font-weight: $font-weight-bold
  line-height: $line-height-tight
  color: var(--color-text)

h1
  font-size: $font-size-4xl
  margin-top: $margin-2xl

h2
  font-size: $font-size-3xl
  margin-top: $margin-xl

h3
  font-size: $font-size-2xl
  margin-top: $margin-lg

h4
  font-size: $font-size-xl
  margin-top: $margin-lg

h5
  font-size: $font-size-lg
  margin-top: $margin-md

h6
  font-size: $font-size-base
  margin-top: $margin-md

// ============================================
// Typography - Paragraphs and Text
// ============================================

p
  margin: $margin-md 0
  line-height: $line-height-relaxed

small
  font-size: $font-size-sm
  color: var(--color-text-secondary)

strong
b
  font-weight: $font-weight-bold

em
i
  font-style: italic

// ============================================
// Typography - Links
// ============================================

a
  color: var(--color-link)
  text-decoration: none
  transition: color $transition-base

a:hover
  color: var(--color-link-hover)
  text-decoration: underline

a:active
  color: var(--color-link-active)

// ============================================
// Typography - Lists
// ============================================

ul
ol
  margin: $margin-md 0
  padding-left: $padding-lg
  line-height: $line-height-relaxed

li
  margin: $margin-sm 0

ul ul
ul ol
ol ul
ol ol
  margin: $margin-sm 0

dl
  margin: $margin-md 0

dt
  font-weight: $font-weight-bold
  margin-top: $margin-md

dd
  margin-left: $margin-lg
  margin-bottom: $margin-sm

// ============================================
// Typography - Code
// ============================================

code
  font-family: $font-family-code
  font-size: 0.9em
  color: var(--color-code-text)
  background-color: var(--color-code-bg)
  padding: 2px 6px
  border-radius: $border-radius-sm

pre
  margin: $margin-md 0
  padding: $padding-lg
  background-color: var(--color-code-bg)
  border-radius: $border-radius-md
  overflow-x: auto
  line-height: $line-height-normal

pre code
  padding: 0
  background-color: transparent
  color: inherit

// ============================================
// Typography - Blockquotes
// ============================================

blockquote
  margin: $margin-lg 0
  padding: $padding-md $padding-lg
  border-left: 4px solid var(--color-link)
  background-color: var(--color-bg-secondary)
  color: var(--color-text-secondary)

blockquote p
  margin: 0

blockquote p + p
  margin-top: $margin-md

// ============================================
// Typography - Horizontal Rule
// ============================================

hr
  margin: $margin-xl 0
  border: none
  border-top: 1px solid var(--color-border)
  height: 0

// ============================================
// Typography - Abbreviation
// ============================================

abbr[title]
  border-bottom: 1px dotted var(--color-border)
  cursor: help
  text-decoration: none

// ============================================
// Typography - Mark
// ============================================

mark
  background-color: #fff3cd
  padding: 2px 4px
  border-radius: $border-radius-sm

// ============================================
// Typography - Subscript and Superscript
// ============================================

sub
sup
  font-size: 0.75em
  line-height: 0
  position: relative
  vertical-align: baseline

sup
  top: -0.5em

sub
  bottom: -0.25em

// ============================================
// Global Elements
// ============================================

img
  max-width: 100%
  height: auto
  display: block

figure
  margin: $margin-lg 0

figcaption
  font-size: $font-size-sm
  color: var(--color-text-secondary)
  margin-top: $margin-sm

// ============================================
// Form Elements
// ============================================

button
input
select
textarea
  font-family: inherit
  font-size: inherit
  line-height: inherit

button
  cursor: pointer
  border: none
  background: none
  padding: 0

input
select
textarea
  border: 1px solid var(--color-border)
  border-radius: $border-radius-md
  padding: $padding-sm $padding-md
  font-size: $font-size-base
  color: var(--color-text)
  background-color: var(--color-bg)
  transition: border-color $transition-base, background-color $transition-base

input:focus
select:focus
textarea:focus
  outline: none
  border-color: var(--color-link)
  box-shadow: var(--glow-soft)

textarea
  resize: vertical
  min-height: 100px

// ============================================
// Table Elements
// ============================================

table
  width: 100%
  border-collapse: collapse
  margin: $margin-lg 0

thead
  background-color: var(--color-bg-secondary)

th
td
  padding: $padding-md
  text-align: left
  border-bottom: 1px solid var(--color-border)

th
  font-weight: $font-weight-bold
  color: var(--color-text)

tbody tr:hover
  background-color: var(--color-bg-secondary)

// ============================================
// Utility Classes
// ============================================

// Disable transitions during theme initialization
.no-transition
  *
  *::before
  *::after
    transition: none !important

.text-center
  text-align: center

.text-left
  text-align: left

.text-right
  text-align: right

.text-justify
  text-align: justify

.text-muted
  color: var(--color-text-secondary)

.text-primary
  color: var(--color-link)

.text-success
  color: $success-color

.text-warning
  color: $warning-color

.text-danger
  color: $danger-color

.text-info
  color: $info-color

.font-weight-light
  font-weight: $font-weight-light

.font-weight-normal
  font-weight: $font-weight-normal

.font-weight-medium
  font-weight: $font-weight-medium

.font-weight-semibold
  font-weight: $font-weight-semibold

.font-weight-bold
  font-weight: $font-weight-bold

.font-weight-extrabold
  font-weight: $font-weight-extrabold

.line-height-tight
  line-height: $line-height-tight

.line-height-normal
  line-height: $line-height-normal

.line-height-relaxed
  line-height: $line-height-relaxed

.line-height-loose
  line-height: $line-height-loose

.no-margin
  margin: 0

.no-padding
  padding: 0

.clearfix
  &::after
    content: ''
    display: table
    clear: both

.sr-only
  position: absolute
  width: 1px
  height: 1px
  padding: 0
  margin: -1px
  overflow: hidden
  clip-path: inset(50%)
  white-space: nowrap
  border-width: 0
