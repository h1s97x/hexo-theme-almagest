// ============================================================
// Dark Theme
// ============================================================

[data-theme='dark']
  // Background Colors —— 深空底色（近黑 + 蓝紫冷调）
  --color-bg: #05070f
  --color-bg-secondary: #0b0f1d
  --color-hover-bg: #131829
  --color-bg-elevated: #101728

  // Text Colors
  --color-text: #e6ecf7
  --color-text-secondary: #9aa6bf
  --color-text-tertiary: #6b7691

  // Border Colors
  --color-border: #1e2740
  --color-border-light: #182034

  // Code Colors
  --color-code-bg: #0b0f1d
  --color-code-text: #dbe4f5
  --color-code-keyword: #a78bfa
  --color-code-string: #6ee7b7
  --color-code-comment: #5c6780
  --color-code-number: #fbbf24
  --color-code-function: #67e8f9
  --color-code-attr: #f0abfc

  // Table Colors
  --color-table-header-bg: #0b0f1d
  --color-table-row-hover: #131829
  --color-table-border: #1e2740

  // Input Colors
  --color-input-bg: #0b0f1d
  --color-input-border: #1e2740
  --color-input-focus: #67e8f9

  // Tag Colors
  --color-tag-bg: rgba(103, 232, 249, 0.1)
  --color-tag-text: #67e8f9
  --color-tag-border: rgba(103, 232, 249, 0.22)

  // Link Colors
  --color-link: #67e8f9
  --color-link-hover: #a5f3fc
  --color-link-active: #38bdf8
  --color-link-accent: #a78bfa

  // Button Colors
  --color-button-primary-bg: #67e8f9
  --color-button-primary-text: #05070f
  --color-button-primary-hover: #8ef0fb

  // Accent / Gradient Colors
  --color-accent: #67e8f9
  --color-accent-2: #818cf8
  --color-accent-3: #a78bfa
  --color-accent-4: #c084fc
  --grad-primary: linear-gradient(120deg, #67e8f9 0%, #818cf8 55%, #c084fc 100%)
  --grad-text: linear-gradient(120deg, #67e8f9 0%, #818cf8 55%, #c084fc 100%)

  // Surface / Glass
  --color-glass-bg: rgba(19, 24, 41, 0.55)
  --color-glass-border: rgba(137, 160, 214, 0.14)
  --color-glass-blur: 18px

  // Alert Colors
  --color-alert-success-bg: rgba(52, 211, 153, 0.1)
  --color-alert-success-text: #6ee7b7
  --color-alert-warning-bg: rgba(251, 191, 36, 0.1)
  --color-alert-warning-text: #fcd34d
  --color-alert-danger-bg: rgba(248, 113, 113, 0.1)
  --color-alert-danger-text: #fca5a5
  --color-alert-info-bg: rgba(103, 232, 249, 0.1)
  --color-alert-info-text: #67e8f9

  // Shadow / Glow Colors
  --color-shadow: rgba(0, 0, 0, 0.55)
  --color-shadow-dark: rgba(0, 0, 0, 0.8)
  --shadow-card: 0 18px 50px -20px rgba(0, 0, 0, 0.85)
  --shadow-card-hover: 0 30px 80px -30px rgba(0, 0, 0, 0.9)
  --glow-primary: 0 0 0 1px rgba(103, 232, 249, 0.18), 0 8px 32px -12px rgba(103, 232, 249, 0.45)
  --glow-soft: 0 8px 40px -18px rgba(103, 232, 249, 0.35)

// ============================================================
// Dark Theme Specific Styles
// ============================================================

@media (prefers-color-scheme: dark)
  :root:not([data-theme])
    // Background Colors —— 深空底色（近黑 + 蓝紫冷调）
    --color-bg: #05070f
    --color-bg-secondary: #0b0f1d
    --color-hover-bg: #131829
    --color-bg-elevated: #101728

    // Text Colors
    --color-text: #e6ecf7
    --color-text-secondary: #9aa6bf
    --color-text-tertiary: #6b7691

    // Border Colors
    --color-border: #1e2740
    --color-border-light: #182034

    // Code Colors
    --color-code-bg: #0b0f1d
    --color-code-text: #dbe4f5
    --color-code-keyword: #a78bfa
    --color-code-string: #6ee7b7
    --color-code-comment: #5c6780
    --color-code-number: #fbbf24
    --color-code-function: #67e8f9
    --color-code-attr: #f0abfc

    // Table Colors
    --color-table-header-bg: #0b0f1d
    --color-table-row-hover: #131829
    --color-table-border: #1e2740

    // Input Colors
    --color-input-bg: #0b0f1d
    --color-input-border: #1e2740
    --color-input-focus: #67e8f9

    // Tag Colors
    --color-tag-bg: rgba(103, 232, 249, 0.1)
    --color-tag-text: #67e8f9
    --color-tag-border: rgba(103, 232, 249, 0.22)

    // Link Colors
    --color-link: #67e8f9
    --color-link-hover: #a5f3fc
    --color-link-active: #38bdf8
    --color-link-accent: #a78bfa

    // Button Colors
    --color-button-primary-bg: #67e8f9
    --color-button-primary-text: #05070f
    --color-button-primary-hover: #8ef0fb

    // Accent / Gradient Colors
    --color-accent: #67e8f9
    --color-accent-2: #818cf8
    --color-accent-3: #a78bfa
    --color-accent-4: #c084fc
    --grad-primary: linear-gradient(120deg, #67e8f9 0%, #818cf8 55%, #c084fc 100%)
    --grad-text: linear-gradient(120deg, #67e8f9 0%, #818cf8 55%, #c084fc 100%)

    // Surface / Glass
    --color-glass-bg: rgba(19, 24, 41, 0.55)
    --color-glass-border: rgba(137, 160, 214, 0.14)
    --color-glass-blur: 18px

    // Alert Colors
    --color-alert-success-bg: rgba(52, 211, 153, 0.1)
    --color-alert-success-text: #6ee7b7
    --color-alert-warning-bg: rgba(251, 191, 36, 0.1)
    --color-alert-warning-text: #fcd34d
    --color-alert-danger-bg: rgba(248, 113, 113, 0.1)
    --color-alert-danger-text: #fca5a5
    --color-alert-info-bg: rgba(103, 232, 249, 0.1)
    --color-alert-info-text: #67e8f9

    // Shadow / Glow Colors
    --color-shadow: rgba(0, 0, 0, 0.55)
    --color-shadow-dark: rgba(0, 0, 0, 0.8)
    --shadow-card: 0 18px 50px -20px rgba(0, 0, 0, 0.85)
    --shadow-card-hover: 0 30px 80px -30px rgba(0, 0, 0, 0.9)
    --glow-primary: 0 0 0 1px rgba(103, 232, 249, 0.18), 0 8px 32px -12px rgba(103, 232, 249, 0.45)
    --glow-soft: 0 8px 40px -18px rgba(103, 232, 249, 0.35)

// ============================================================
// Dark Theme Component Styles
// ============================================================

[data-theme='dark']
  // Links
  a
    color: var(--color-link)

    &:hover
      color: var(--color-link-hover)

    &:active
      color: var(--color-link-active)

  // Buttons
  button
  .button
    background-color: var(--color-button-primary-bg)
    color: var(--color-button-primary-text)

    &:hover
      background-color: var(--color-button-primary-hover)

  // Code blocks
  code
  pre
    background-color: var(--color-code-bg)
    color: var(--color-code-text)

  // Tables
  table
    border-color: var(--color-table-border)

    thead
      background-color: var(--color-table-header-bg)

    tbody tr:hover
      background-color: var(--color-table-row-hover)

  // Inputs
  input
  select
  textarea
    background-color: var(--color-input-bg)
    border-color: var(--color-input-border)
    color: var(--color-text)

    &:focus
      border-color: var(--color-input-focus)
      box-shadow: 0 0 0 3px rgba(103, 232, 249, 0.14)

  // Tags
  .tag
    background-color: var(--color-tag-bg)
    color: var(--color-tag-text)
    border-color: var(--color-tag-border)

  // Alerts
  .alert
    &.alert-success
      background-color: var(--color-alert-success-bg)
      color: var(--color-alert-success-text)

    &.alert-warning
      background-color: var(--color-alert-warning-bg)
      color: var(--color-alert-warning-text)

    &.alert-danger
      background-color: var(--color-alert-danger-bg)
      color: var(--color-alert-danger-text)

    &.alert-info
      background-color: var(--color-alert-info-bg)
      color: var(--color-alert-info-text)

  // Blockquotes
  blockquote
    background-color: var(--color-bg-secondary)
    border-left-color: var(--color-link)
    color: var(--color-text-secondary)

  // Cards
  .card
    background-color: var(--color-bg)
    border-color: var(--color-border)
    box-shadow: 0 1px 3px var(--color-shadow)


