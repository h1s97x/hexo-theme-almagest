<aside class="sidebar">
  <!-- Widget: About -->
  <div class="widget widget-about">
    <div class="widget-content">
      <p><%= config.description %></p>
    </div>
  </div>

  <!-- Widget: Recent Posts -->
  <div class="widget widget-recent">
    <h3 class="widget-title"><%= __('recent_posts') %></h3>
    <ul class="widget-list widget-list--recent">
      <% site.posts.limit(5).each(function(post) { %>
        <li>
          <a href="<%= url_for(post.path) %>"><%= post.title %></a>
        </li>
      <% }); %>
    </ul>
  </div>

  <!-- Widget: Categories -->
  <% if (site.categories.length > 0) { %>
    <div class="widget widget-categories">
      <h3 class="widget-title"><%= __('categories') %></h3>
      <ul class="widget-list widget-list--categories">
        <% site.categories.forEach(cat => { %>
          <li>
            <a href="<%= url_for(cat.path) %>" class="category-link">
              <span class="category-name"><%= cat.name %></span>
              <span class="category-count"><%= cat.length %></span>
            </a>
          </li>
        <% }); %>
      </ul>
    </div>
  <% } %>

  <!-- Widget: Tags -->
  <% if (site.tags.length > 0) { %>
    <div class="widget widget-tags">
      <h3 class="widget-title"><%= __('tags') %></h3>
      <div class="widget-tags-cloud">
        <% site.tags.forEach(tag => {
              // 将 tag.length 归一化到 [0, 1] 后映射到 1~3 共 3 档，
              // 完全移除之前模板里内联 style="font-size: ...px" 的写法
              var maxLen = site.tags.reduce(function(max, t) { return Math.max(max, t.length); }, 0);
              var ratio = maxLen > 0 ? tag.length / maxLen : 0;
              var sizeClass = 'tag-size-' + (1 + Math.round(ratio * 2));
        %>
          <a href="<%= url_for(tag.path) %>" class="tag-cloud-item <%= sizeClass %>" title="<%= tag.length %> 篇">
            <%= tag.name %>
          </a>
        <% }); %>
      </div>
    </div>
  <% } %>
</aside>