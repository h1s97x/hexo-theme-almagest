<%
// Scripts partial
// 统一在这里引入主题前端 JS，保证所有走 layout.ejs 的页面都加载脚本。
// 资源通过 cdn_prefix + version 拼接，便于部署 CDN / 缓存刷新。
const config = theme;
const cdn_prefix = config.cdn_prefix || '';
const version = config.version || theme_version();
const asset = function(path) {
  const base = cdn_prefix ? cdn_prefix.replace(/\/$/, '') : '';
  return url_for(base + path + '?v=' + version);
};
%>

<!-- 前端统一配置：主题版本 + i18n 文案 + 检索地址。
     前端脚本统一从 window.__almagestConfig 读取，不再各自依赖零散全局变量。
     用 application/json 类型 + \u 转义，内容不会被当作 JS 执行。 -->
<script id="almagest-config" type="application/json">
  <%- alm_export_config() %>
</script>

<!-- Theme Core -->
<script src="<%= asset('/js/theme.js') %>" defer></script>

<% if (config.features?.search) { %>
  <script src="<%= asset('/js/search.js') %>" defer></script>
<% } %>

<% if (config.image?.lazy_load) { %>
  <script src="<%= asset('/js/lazy-load.js') %>" defer></script>
<% } %>

<% if (config.features?.code_copy) { %>
  <script src="<%= asset('/js/code-copy.js') %>" defer></script>
<% } %>

<!--
  highlight.js 运行库
  ============================================================
  注意 1：head.ejs 只引入了 highlight.js 的「样式表」，样式表本身不做任何高亮。
          若此处不引入运行库，代码块将始终是纯文本（无语法着色）。

  注意 2：必须使用「浏览器构建产物」，不能用 npm 包的 lib/*.js。
          - npm/highlight.js@x/lib/common.min.js  → 仅 ~2.5KB，内部调用 require()，
            这是给 Node 用的入口，浏览器里会抛 "require is not defined"，
            加载后 window.hljs 仍是 undefined。
          - npm/@highlightjs/cdn-assets@x/highlight.min.js → ~129KB，浏览器可用。
          cdn 配置项应为「包根地址」，本模板负责拼 /highlight.min.js 与 /styles/。
  注意 3：使用 defer，保证与 code-copy.js 一样在 DOM 解析后按序执行；
          高亮在 DOMContentLoaded 后统一触发。
-->
<% if (config.code_highlight?.enable !== false) { %>
  <%
    const hljs_ver = '11.12.0';
    const hljs_base = config.code_highlight?.cdn || ('https://cdn.jsdelivr.net/npm/@highlightjs/cdn-assets@' + hljs_ver);
  %>
  <script src="<%= hljs_base %>/highlight.min.js" defer></script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      if (typeof window.hljs === 'undefined') {
        // 运行库未加载（离线 / CDN 不可达）时静默降级：代码仍是可读纯文本
        return;
      }
      document.querySelectorAll('pre code').forEach(function (block) {
        if (block.dataset.highlighted === 'yes') return;
        window.hljs.highlightElement(block);
      });
    });
  </script>
<% } %>

<% if (config.features?.starfield !== false) { %>
  <script src="<%= asset('/js/astronomy.js') %>" defer></script>
<% } %>

<!-- Custom Inject: body_end -->
<% if (config.inject?.body_end) { %>
  <%- config.inject.body_end %>
<% } %>
