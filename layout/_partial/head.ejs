<%
const config = theme;
const site_config = config;
%>

<!-- Meta Tags -->
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta http-equiv="X-UA-Compatible" content="ie=edge">

<!-- Title -->
<title>
  <% if (page.title) { %>
    <%= page.title %> - <%= config.title %>
  <% } else { %>
    <%= config.title %>
  <% } %>
</title>

<!-- Description -->
<meta name="description" content="<%= page.description || config.description || '' %>">

<!-- Keywords -->
<% if (page.tags && page.tags.length > 0) { %>
  <meta name="keywords" content="<% page.tags.forEach((tag, idx) => { %><%= tag.name %><% if (idx < page.tags.length - 1) { %>, <% } %><% }); %>">
<% } %>

<!-- Author -->
<meta name="author" content="<%= config.author %>">

<!-- Open Graph Meta Tags -->
<%
const ogTitle = page.title || config.title;
const ogDescription = page.description || page.excerpt || config.description || '';
const ogUrl = url.replace(/\\/g, '/') + (page.path || '');
const ogSiteName = config.title;
const ogType = page.layout === 'post' ? 'article' : 'website';

// 获取封面图
let ogImage = '';
if (page.cover) {
  ogImage = url_for(page.cover);
} else if (page.images && page.images.length > 0) {
  ogImage = url_for(page.images[0]);
} else if (config.index?.banner_img) {
  ogImage = url_for(config.index.banner_img);
}
%>

<!-- Open Graph -->
<meta property="og:type" content="<%= ogType %>">
<meta property="og:title" content="<%= ogTitle %>">
<meta property="og:description" content="<%= ogDescription %>">
<meta property="og:url" content="<%= ogUrl %>">
<meta property="og:site_name" content="<%= ogSiteName %>">
<% if (ogImage) { %>
<meta property="og:image" content="<%= ogImage %>">
<% } %>

<!-- Twitter Card -->
<% const twitterCard = config.open_graph?.twitter_card || 'summary_large_image'; %>
<meta name="twitter:card" content="<%= twitterCard %>">
<% if (config.open_graph?.twitter_id) { %>
<meta name="twitter:site" content="<%= config.open_graph.twitter_id %>">
<meta name="twitter:creator" content="<%= config.open_graph.twitter_id %>">
<% } %>
<meta name="twitter:title" content="<%= ogTitle %>">
<meta name="twitter:description" content="<%= ogDescription %>">
<% if (ogImage) { %>
<meta name="twitter:image" content="<%= ogImage %>">
<% } %>

<!-- Article Specific Open Graph (for posts) -->
<% if (page.layout === 'post') { %>
  <% if (page.date) { %>
<meta property="article:published_time" content="<%= page.date.toISOString() %>">
  <% } %>
  <% if (page.updated) { %>
<meta property="article:modified_time" content="<%= page.updated.toISOString() %>">
  <% } %>
  <% if (page.tags && page.tags.length > 0) { %>
    <% page.tags.forEach(tag => { %>
<meta property="article:tag" content="<%= tag.name %>">
    <% }); %>
  <% } %>
<% } %>

<!-- Theme Color -->
<meta name="theme-color" content="<%= config.style?.primary_color || '#0066cc' %>">

<!-- Favicon -->
<link rel="icon" href="<%= url_for('/favicon.ico') %>">

<!-- Stylesheets -->
<link rel="stylesheet" href="<%= url_for('/css/main.css') %>">

<!-- Fonts -->
<% if (config.font?.font_family) { %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=<%= config.font.font_family %>:wght@400;500;600;700&display=swap" rel="stylesheet">
<% } else { %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<% } %>

<!-- Iconfont -->
<% if (config.iconfont) { %>
  <link rel="stylesheet" href="<%= config.iconfont %>">
<% } %>

<!-- Code Highlight (双主题支持) -->
<% if (config.highlight?.enable) { %>
  <% const hljsVersion = '11.8.0'; %>
  <% const lightTheme = config.highlight?.light_theme || 'github'; %>
  <% const darkTheme = config.highlight?.dark_theme || 'atom-one-dark'; %>
  <% const hljsPrefix = config.static_prefix?.highlightjs || 'https://cdn.jsdelivr.net/npm/highlight.js'; %>
  <link rel="stylesheet" href="<%= hljsPrefix %>@<%= hljsVersion %>/styles/<%= lightTheme %>.min.css" id="hljs-light">
  <link rel="stylesheet" href="<%= hljsPrefix %>@<%= hljsVersion %>/styles/<%= darkTheme %>.min.css" id="hljs-dark" disabled>
  <script>
    (function() {
      var STORAGE_KEY = 'theme-preference';
      var THEME_ATTRIBUTE = 'data-theme';
      var hljsLight = document.getElementById('hljs-light');
      var hljsDark = document.getElementById('hljs-dark');

      function updateCodeTheme(theme) {
        if (!hljsLight || !hljsDark) return;
        if (theme === 'dark') {
          hljsLight.disabled = true;
          hljsDark.disabled = false;
        } else {
          hljsLight.disabled = false;
          hljsDark.disabled = true;
        }
      }

      function init() {
        var savedTheme = localStorage.getItem(STORAGE_KEY);
        if (savedTheme) {
          updateCodeTheme(savedTheme);
        } else {
          var isDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          updateCodeTheme(isDark ? 'dark' : 'light');
        }
      }

      init();

      // Listen for theme changes
      document.addEventListener('themeChanged', function(e) {
        updateCodeTheme(e.detail.theme);
      });

      // Also update on system preference change
      if (window.matchMedia) {
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e) {
          if (!localStorage.getItem(STORAGE_KEY)) {
            updateCodeTheme(e.matches ? 'dark' : 'light');
          }
        });
      }
    })();
  </script>
<% } %>

<!-- KaTeX (数学公式) -->
<% if (config.math?.enable && config.math?.engine === 'katex') { %>
  <% const katexVersion = config.math?.katex?.version || '0.16.9'; %>
  <% const katexPrefix = config.static_prefix?.katex || 'https://cdn.jsdelivr.net/npm/katex'; %>
  <link rel="stylesheet" href="<%= katexPrefix %>@<%= katexVersion %>/dist/katex.min.css" integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV" crossorigin="anonymous">
  <link rel="stylesheet" href="<%= katexPrefix %>@<%= katexVersion %>/dist/contrib/copy-tex.min.css">
<% } %>

<!-- MathJax (数学公式) -->
<% if (config.math?.enable && config.math?.engine === 'mathjax') { %>
  <% const mathjaxPrefix = config.static_prefix?.mathjax || 'https://cdn.jsdelivr.net/npm/mathjax'; %>
  <% if (config.math?.mathjax?.version === '3') { %>
    <script id="MathJax-script" async src="<%= mathjaxPrefix %>@3/es5/tex-mml-chtml.js"></script>
  <% } else { %>
    <script src="<%= mathjaxPrefix %>@2.7.9/MathJax.js?config=TeX-MML-AM_CHTML"></script>
  <% } %>
<% } %>

<!-- Theme Global Config -->
<script>
window.themeConfig = window.themeConfig || {};
window.themeConfig.darkMode = '<%= config.dark_mode?.default || config.style?.prefers_theme || 'auto' %>';
</script>

<!-- Theme Initialization Script (prevents FOUC) -->
<script>
  (function() {
    const STORAGE_KEY = 'theme-preference';
    const THEME_ATTRIBUTE = 'data-theme';
    // 主题默认配置，从主题配置注入
    const defaultMode = '<%= config.dark_mode?.default || config.style?.prefers_theme || 'auto' %>';
    
    function getSystemPreference() {
      if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
        return 'dark';
      }
      if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) {
        return 'light';
      }
      return null;
    }
    
    function getDefaultTheme() {
      if (defaultMode === 'dark') {
        return 'dark';
      }
      if (defaultMode === 'light') {
        return 'light';
      }
      // auto: 优先遵循系统偏好
      const systemPreference = getSystemPreference();
      if (systemPreference) {
        return systemPreference;
      }
      // 无系统偏好时，检查本地时间 (18:00-06:00 使用暗色)
      var hour = new Date().getHours();
      if (hour >= 18 || hour < 6) {
        return 'dark';
      }
      return 'light';
    }
    
    function initTheme() {
      const html = document.documentElement;
      
      // Add no-transition class to prevent FOUC
      html.classList.add('no-transition');
      
      const savedTheme = localStorage.getItem(STORAGE_KEY);
      if (savedTheme && (savedTheme === 'light' || savedTheme === 'dark')) {
        html.setAttribute(THEME_ATTRIBUTE, savedTheme);
      } else {
        html.setAttribute(THEME_ATTRIBUTE, getDefaultTheme());
      }
      
      // Remove no-transition class after a brief delay
      setTimeout(function() {
        html.classList.remove('no-transition');
      }, 10);
    }
    
    initTheme();
  })();
</script>

<!-- Custom Inject -->
<% if (config.inject?.head) { %>
  <%- config.inject.head %>
<% } %>
