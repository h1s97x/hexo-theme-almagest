<%
const config = theme;
const cdn_prefix = config.cdn_prefix || '';
const version = config.version || '1.0.0';
const asset = function(path) {
  const base = cdn_prefix ? cdn_prefix.replace(/\/$/, '') : '';
  return url_for(base + path + '?v=' + version);
};
%>

<!-- Meta Tags -->
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta http-equiv="X-UA-Compatible" content="ie=edge">

<!-- Title -->
<title>
  <% if (page.title) { %>
    <%= page.title %> - <%= config.title %>
  <% } else { %>
    <%= config.title %>
  <% } %>
</title>

<!-- Description -->
<meta name="description" content="<%= page.description || config.description || '' %>">

<!-- Keywords -->
<% if (page.tags && page.tags.length > 0) { %>
  <meta name="keywords" content="<% page.tags.forEach(function(tag, idx) { %><%= tag.name %><% if (idx < page.tags.length - 1) { %>, <% } %><% }); %>">
<% } %>

<!-- Author -->
<meta name="author" content="<%= config.author %>">

<!-- Theme Color -->
<meta name="theme-color" content="<%= config.style?.primary_color || '#0066cc' %>">

<!-- Favicon -->
<link rel="icon" href="<%= url_for('/favicon.ico') %>">

<!-- Stylesheets -->
<link rel="stylesheet" href="<%= asset('/css/main.css') %>">

<!-- 图片占位色（_config.yml image.placeholder_color，供懒加载 img[data-src] / img.error 使用） -->
<style>
  :root { --color-image-placeholder: <%= config.image?.placeholder_color || '#f0f0f0' %>; }
</style>

<!-- Fonts -->
<% if (config.fonts?.google_fonts !== false) { %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="<%= config.fonts?.google_fonts_url || 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap' %>" rel="stylesheet">
<% } %>

<!-- Code Highlight -->
<% if (config.code_highlight?.enable !== false) { %>
  <%
    const code_theme = config.style?.code_theme || config.code_highlight?.theme || 'atom-one-light';
    const hljs_cdn = config.code_highlight?.cdn || 'https://cdn.jsdelivr.net/npm/highlight.js@11.8.0';
  %>
  <link rel="stylesheet" href="<%= hljs_cdn %>/styles/<%= code_theme %>.min.css">
<% } %>

<!-- Custom Inject: head -->
<% if (config.inject?.head) { %>
  <%- config.inject.head %>
<% } %>
