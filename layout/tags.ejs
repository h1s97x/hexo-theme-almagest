---
layout: layout
---
<%
// 标签页面内容片段（由 layout.ejs 统一包裹）
const config = theme;
%>

<div class="page-header">
  <h1 class="page-title"><%= __('tags') %></h1>
  <p class="page-subtitle"><%= __('tags_desc') %></p>
</div>

<div class="tags-container">
  <% if (site.tags.length > 0) { %>
    <%
      // 循环外一次性计算标签数量的极值，避免每轮循环重复 map 求值
      var counts = site.tags.map(function(t) { return t.posts.length; });
      var maxCount = Math.max.apply(Math, counts);
      var minCount = Math.min.apply(Math, counts);
    %>
    <div class="tag-cloud">
      <% site.tags.forEach(function(tag) { %>
        <%
          var postCount = tag.posts.length;
          var size = minCount === maxCount ? 1 : (postCount - minCount) / (maxCount - minCount);
          var sizeClass = 'tag-size-' + Math.ceil(size * 5);
        %>
        <a href="<%= url_for('/tags/' + tag.name + '/') %>" class="tag-link <%= sizeClass %>" title="<%= tag.name %> (<%= postCount %> posts)">
          <%= tag.name %>
        </a>
      <% }); %>
    </div>
  <% } else { %>
    <div class="no-tags">
      <p><%= __('no_tags') %></p>
    </div>
  <% } %>
</div>

<% if (site.tags.length > 0) { %>
  <div class="tags-list">
    <h2><%= __('all_tags') %></h2>
    <% site.tags.forEach(function(tag) { %>
      <div class="tag-section">
        <h3 class="tag-title">
          <a href="<%= url_for('/tags/' + tag.name + '/') %>">
            <%= tag.name %>
          </a>
        </h3>
        <span class="tag-count"><%= tag.posts.length %></span>
        <div class="tag-posts">
          <% tag.posts.forEach(function(post) { %>
            <div class="post-item">
              <a href="<%= url_for(post.path) %>" class="post-link">
                <%= post.title %>
              </a>
              <span class="post-date"><%= date(post.date, 'YYYY-MM-DD') %></span>
            </div>
          <% }); %>
        </div>
      </div>
    <% }); %>
  </div>
<% } %>
