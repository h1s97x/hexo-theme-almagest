<%
/**
 * 404 错误页面布局
 * 参考 Fluid 主题的 404 页面实现
 * 包含错误提示、自动跳转、返回首页按钮
 */

const config = theme;
const page404Cfg = config.page404 || {};
const redirectDelay = page404Cfg.redirect_delay || 5000;
%>

<div class="page-404">
  <div class="error-code">404</div>
  <h1 class="error-title"><%= __('404.title') || '页面未找到' %></h1>
  <p class="error-desc"><%= __('404.description') || '抱歉，您访问的页面不存在或已被移除' %></p>

  <div class="error-actions">
    <a href="<%= url_for('/') %>" class="error-btn btn-primary">
      <svg viewBox="0 0 24 24" width="16" height="16" style="margin-right: 6px;">
        <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" fill="currentColor"/>
      </svg>
      <%= __('404.back_home') || '返回首页' %>
    </a>
    <a href="javascript:history.back();" class="error-btn btn-secondary">
      <svg viewBox="0 0 24 24" width="16" height="16" style="margin-right: 6px;">
        <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z" fill="currentColor"/>
      </svg>
      <%= __('404.go_back') || '返回上页' %>
    </a>
  </div>

  <% if (redirectDelay > 0) { %>
    <div class="error-countdown" id="error-countdown">
      <%= redirectDelay / 1000 %> 秒后自动返回首页...
    </div>

    <script>
      (function() {
        'use strict';

        var delay = <%= redirectDelay %>;
        var countdownEl = document.getElementById('error-countdown');
        var remaining = Math.floor(delay / 1000);

        function updateCountdown() {
          if (remaining <= 0) {
            window.location.href = '<%= url_for('/') %>';
            return;
          }

          if (countdownEl) {
            countdownEl.textContent = remaining + ' 秒后自动返回首页...';
          }
          remaining--;
          setTimeout(updateCountdown, 1000);
        }

        // 启动倒计时
        setTimeout(updateCountdown, 1000);
      })();
    </script>
  <% } %>
</div>
