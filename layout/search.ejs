---
layout: layout
---
<%
// 搜索页面内容片段（由 layout.ejs 统一包裹）
const config = theme;
%>

<div class="page-header">
  <h1 class="page-title"><%= __('search') %></h1>
  <p class="page-subtitle"><%= __('search_desc') %></p>
</div>

<div class="search-container">
  <div class="search-box-wrapper">
    <%- partial('_partial/search-box') %>
  </div>

  <div id="search-results" class="search-results">
    <div class="no-results">
      <p><%= __('search_no_results') %></p>
    </div>
  </div>
</div>

<!-- 注入 i18n 文案，供 search.js 使用 -->
<script>
  window.__almagestSearchEmpty = <%- JSON.stringify(__('search_no_results')) %>;
  window.__almagestSearchNoResults = <%- JSON.stringify(__('search_no_results')) %>;
</script>

<script type="application/json" data-search-data>
  <%- JSON.stringify(site.posts.map(post => ({
    title: post.title,
    url: post.path,
    content: post.content || post.excerpt || '',
    date: post.date
  }))).replace(/<\/script>/g, '<\\/script>') %>
</script>
