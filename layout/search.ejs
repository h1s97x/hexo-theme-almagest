---
layout: layout
---
<%
// 搜索页面内容片段（由 layout.ejs 统一包裹）
const config = theme;
%>

<div class="page-header">
  <h1 class="page-title"><%= __('search') %></h1>
  <p class="page-subtitle"><%= __('search_desc') %></p>
</div>

<div class="search-container">
  <div class="search-box-wrapper">
    <%- partial('_partial/search-box') %>
  </div>

  <div id="search-results" class="search-results">
    <div class="no-results">
      <p><%= __('search_empty') %></p>
    </div>
  </div>
</div>

<!-- 搜索索引地址与文案统一来自 scripts.ejs 注入的 window.__almagestConfig
     （search.url / search.empty / search.noResults），此处不再重复注入。 -->
